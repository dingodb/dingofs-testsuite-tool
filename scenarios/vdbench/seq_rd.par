#
# Vdbench sequential read parameter file
# For DingoFS storage testing
#

# Host definition
hd=default,vdbench=/opt/vdbench,user=root,shell=ssh
hd=localhost,system=localhost

# Storage Definition - file based test
sd=sd1,host=localhost,lun=/data/seqrd_testfile,size=100m

# Workload Definition - sequential read operation
wd=wd1,sd=sd1,rdpct=100,xfersize=64k

# Run Definition - execute the test
rd=rd1,wd=wd1,iorate=100,elapsed=5,interval=1
