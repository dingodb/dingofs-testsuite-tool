#!/bin/bash
#
# DingoFS Benchmark Tool - Wrapper script for docker-based benchmark testing
# Usage: source dingofs_benchmark_tool from any directory, or run directly
#

set -e

# ==============================================================================
# Global Variables
# ==============================================================================

# Config directory
: "${DINGOFS_BENCHMARK_CONFIG_DIR:=$HOME/.dingofs_benchmark}"
CONFIG_DIR="$DINGOFS_BENCHMARK_CONFIG_DIR"
TESTDIR_FILE="$CONFIG_DIR/testdir"
OUTPUT_FILE="$CONFIG_DIR/output"
IMAGE_FILE="$CONFIG_DIR/image"

# Default image
DEFAULT_IMAGE="localhost/dingofs-benchmark-tools:latest"

# Ensure config directory exists
mkdir -p "$CONFIG_DIR"

# ==============================================================================
# Helper Functions
# ==============================================================================

load_config() {
    local key="$1"
    case "$key" in
        testdir)
            [[ -f "$TESTDIR_FILE" ]] && cat "$TESTDIR_FILE" || echo ""
            ;;
        output)
            [[ -f "$OUTPUT_FILE" ]] && cat "$OUTPUT_FILE" || echo ""
            ;;
        image)
            [[ -f "$IMAGE_FILE" ]] && cat "$IMAGE_FILE" || echo "$DEFAULT_IMAGE"
            ;;
    esac
}

save_config() {
    local key="$1"
    local value="$2"
    case "$key" in
        testdir)
            echo "$value" > "$TESTDIR_FILE"
            ;;
        output)
            echo "$value" > "$OUTPUT_FILE"
            ;;
        image)
            echo "$value" > "$IMAGE_FILE"
            ;;
    esac
}

list_docker_images() {
    echo "Available dingofs-benchmark-tools images:"
    docker images --format "{{.Repository}}:{{.Tag}}" 2>/dev/null | grep -E "dingofs-benchmark-tools|benchmark-tools" || echo "  (no matching images found)"
    echo ""
    echo "All Docker images:"
    docker images --format "  {{.Repository}}:{{.Tag}}" 2>/dev/null
}

show_help() {
    cat << EOF
DingoFS Benchmark Tool (dbt)
============================

A wrapper script for running DingoFS storage benchmark tests via Docker.

Usage:
  dingofs_benchmark_tool <command> [options]
  dbt <command> [options]          # Shortcut alias

Commands:
  config <subcommand>      Manage configuration
  debug                    Start an interactive shell in the benchmark container
  help                     Show this help message
  (dbt is an alias for dingofs_benchmark_tool)

Config Subcommands:
  dingofs_benchmark_tool config set testdir <dir>   Set test directory (mount point)
  dingofs_benchmark_tool config set output <dir>    Set output directory
  dingofs_benchmark_tool config set image <name>    Set Docker image
  dingofs_benchmark_tool config show                Show current configuration

Test Commands (run benchmark):
  dingofs_benchmark_tool -t <tool> -s <scenario> [-n <np>] [options]
                          Run a benchmark test
                          (use config values for testdir/output if not specified)

Options for test command:
  -t, --tool <name>       Test tool: fio, vdbench, mdtest, pjdtest
  -s, --scenario <name>   Test scenario name
  -n, --np <num>          MPI process count for mdtest (default: 16)
  -m, --mount <dir>       Override test directory (from config)
  -o, --output <dir>      Override output directory (from config)

Examples:
  # First-time setup: configure settings
  dingofs_benchmark_tool config set testdir /mnt/test
  dingofs_benchmark_tool config set output /tmp/results
  dingofs_benchmark_tool config set image localhost/dingofs-benchmark-tools:latest

  # Show current configuration
  dingofs_benchmark_tool config show

  # Run fio sequential write test (uses config values for testdir/output)
  dingofs_benchmark_tool -t fio -s seq_write

  # Run fio with explicit directories
  dingofs_benchmark_tool -m /mnt/test -o /tmp/results -t fio -s seq_write

  # Run mdtest with custom process count
  dingofs_benchmark_tool -t mdtest -s mdtest -n 32

  # Run pjdtest
  dingofs_benchmark_tool -t pjdtest -s pjdtest

  # Enter debug shell
  dingofs_benchmark_tool debug

Notes:
  - Configuration is persisted in $CONFIG_DIR
  - If -m/-o not provided, uses values from 'config set'
  - If config values not set, you will be prompted to set them

EOF
}

# ==============================================================================
# Command Handlers
# ==============================================================================

cmd_config() {
    local subcommand="$1"
    shift

    case "$subcommand" in
        set)
            local key="$1"
            local value="$2"
            if [[ -z "$key" ]] || [[ -z "$value" ]]; then
                echo "Error: key and value required"
                echo "Usage: dingofs_benchmark_tool config set <key> <value>"
                echo "Keys: testdir, output, image"
                return 1
            fi

            case "$key" in
                testdir|output|image)
                    save_config "$key" "$value"
                    echo "$key set to: $value"
                    ;;
                *)
                    echo "Error: Unknown config key '$key'"
                    echo "Valid keys: testdir, output, image"
                    return 1
                    ;;
            esac
            ;;
        show)
            echo "Current Configuration:"
            local td=$(load_config testdir)
            local out=$(load_config output)
            local img=$(load_config image)
            echo "  testdir: ${td:-not set}"
            echo "  output:  ${out:-not set}"
            echo "  image:   ${img:-not set}"
            ;;
        *)
            if [[ -z "$subcommand" ]]; then
                echo "Error: subcommand required"
                echo "Usage: dingofs_benchmark_tool config <set|show>"
                return 1
            fi
            echo "Error: Unknown config subcommand '$subcommand'"
            echo "Usage: dingofs_benchmark_tool config <set|show>"
            return 1
            ;;
    esac
}

cmd_debug() {
    local image=$(load_config image)
    local testdir=$(load_config testdir)
    local output=$(load_config output)

    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dingofs_benchmark_tool config set image <image>' first."
        return 1
    fi

    echo "Starting debug shell with image: $image"
    echo "Testdir: ${testdir:-<not set>}"
    echo "Output: ${output:-<not set>}"
    echo ""
    echo "Type 'exit' to leave the container"
    echo ""

    local docker_cmd=("docker" "run" "-it" "--rm")

    if [[ -n "$testdir" ]]; then
        docker_cmd+=("-v" "${testdir}:/data")
    fi

    if [[ -n "$output" ]]; then
        docker_cmd+=("-v" "${output}:/output")
    fi

    docker_cmd+=("$image" "/bin/bash")

    "${docker_cmd[@]}"
}

run_benchmark() {
    local image=$(load_config image)
    local config_testdir=$(load_config testdir)
    local config_output=$(load_config output)

    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dingofs_benchmark_tool config set image <image>' first."
        echo ""
        echo "Usage:"
        echo "  dingofs_benchmark_tool config set image localhost/dingofs-benchmark-tools:latest"
        return 1
    fi

    # Parse arguments
    local mount="" output="" tool="" scenario="" np="${NP:-16}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--mount)
                mount="$2"
                shift 2
                ;;
            -o|--output)
                output="$2"
                shift 2
                ;;
            -t|--tool)
                tool="$2"
                shift 2
                ;;
            -s|--scenario)
                scenario="$2"
                shift 2
                ;;
            -n|--np)
                np="$2"
                shift 2
                ;;
            *)
                echo "Error: Unknown option '$1'"
                return 1
                ;;
        esac
    done

    # Use config values if not provided via command line
    mount="${mount:-$config_testdir}"
    output="${output:-$config_output}"

    # Validate required parameters
    if [[ -z "$mount" ]]; then
        echo "Error: Test directory not set."
        echo "Please run 'dingofs_benchmark_tool config set testdir <directory>' first."
        return 1
    fi

    if [[ -z "$output" ]]; then
        echo "Error: Output directory not set."
        echo "Please run 'dingofs_benchmark_tool config set output <directory>' first."
        return 1
    fi

    if [[ -z "$tool" ]]; then
        echo "Error: -t <tool> is required (fio, vdbench, mdtest, pjdtest)"
        return 1
    fi

    # Validate mount directory exists
    if [[ ! -d "$mount" ]]; then
        echo "Error: Mount directory '$mount' does not exist"
        return 1
    fi

    # Create output directory if it doesn't exist
    mkdir -p "$output"

    # Build docker command
    local docker_cmd=(
        docker run --rm
        -v "${mount}:/data"
        -v "${output}:/output"
    )

    # Build entrypoint command
    local entrypoint_cmd=(
        /entrypoint.sh
        -t "$tool"
        -m /data
        -o /output
    )

    # Add scenario for all tools (including mdtest)
    if [[ "$tool" != "ltp" ]]; then
        if [[ -z "$scenario" ]]; then
            echo "Error: -s <scenario> is required for fio, vdbench, mdtest, and pjdtest"
            return 1
        fi
        entrypoint_cmd+=(-s "$scenario")
    fi

    # Add np for mdtest
    if [[ "$tool" == "mdtest" ]]; then
        entrypoint_cmd+=(-n "$np")
    fi

    echo "Running benchmark with image: $image"
    echo "Mount: $mount -> /data"
    echo "Output: $output -> /output"
    echo "Tool: $tool"
    if [[ -n "$scenario" ]]; then
        echo "Scenario: $scenario"
    fi
    if [[ "$tool" == "mdtest" ]]; then
        echo "NP: $np"
    fi
    echo ""

    # Execute docker command with entrypoint
    "${docker_cmd[@]}" "$image" "${entrypoint_cmd[@]}"
}

# ==============================================================================
# Main Entry Point
# ==============================================================================

dingofs_benchmark_tool() {
    local command="$1"

    case "$command" in
        config)
            shift
            cmd_config "$@"
            ;;
        debug)
            cmd_debug
            ;;
        help|--help|-h)
            show_help
            ;;
        -t|--tool|-s|--scenario|-n|--np|-m|--mount|-o|--output)
            # Handle case where command starts with options (no explicit command)
            run_benchmark "$@"
            ;;
        *)
            if [[ -z "$command" ]]; then
                echo "Error: No command specified"
                echo "Run 'dingofs_benchmark_tool help' for usage information"
                return 1
            fi
            echo "Error: Unknown command '$command'"
            echo "Run 'dingofs_benchmark_tool help' for usage information"
            return 1
            ;;
    esac
}

# If script is executed directly (not sourced), run the command
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    dingofs_benchmark_tool "$@"
fi

# Shortcut alias (when sourced)
alias dbt='dingofs_benchmark_tool'