run_testsuite() {
    local image=$(load_config image)
    local config_testdir=$(load_config testdir)
    local config_output=$(load_config output)
    local config_mdsaddr=$(load_config mdsaddr)
    local config_custom=$(load_config custom)
    local runtime=$(load_config runtime)

    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dingofs-testsuite-tool config set image <image>' first."
        echo ""
        echo "Usage:"
        echo "  dingofs-testsuite-tool config set image localhost/dingofs-testsuite-tools:latest"
        return 1
    fi

    # Parse arguments
    local mount="" output="" tool="" scenario="" np="${NP:-16}" bs_size="normal"
    local wechat="" email_to=""
    local scale="${SCALE:-small}" file_count="" gpu_count="${GPU_COUNT:-1}" debug=""
    local setup_env=""
    local do_cleanup=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--mount)
                mount="$2"
                shift 2
                ;;
            -o|--output)
                output="$2"
                shift 2
                ;;
            -t|--tool)
                tool="$2"
                shift 2
                ;;
            -s|--scenario)
                scenario="$2"
                shift 2
                ;;
            -n|--np)
                np="$2"
                shift 2
                ;;
            --wechat)
                wechat="yes"
                shift
                ;;
            --email)
                email_to="yes"
                shift
                ;;
            --bs_size)
                bs_size="$2"
                shift 2
                ;;
            --scale)
                scale="$2"
                shift 2
                ;;
            --file_count)
                file_count="$2"
                shift 2
                ;;
            --gpu_count)
                gpu_count="$2"
                shift 2
                ;;
            --debug)
                debug="yes"
                shift
                ;;
            --setup-env)
                setup_env="$2"
                shift 2
                ;;
            --cleanup)
                do_cleanup="yes"
                shift
                ;;
            --cleanup-env)
                cmd_cleanup_env "$2"
                return $?
                ;;
            --help|-h)
                if [[ -n "$tool" ]]; then
                    if [[ "$tool" == "mlperf" ]]; then
                        show_mlperf_help
                        exit 0
                    else
                        run_docker_help "$tool"
                        exit $?
                    fi
                else
                    show_help
                    exit 0
                fi
                ;;
            *)
                echo "Error: Unknown option '$1'"
                return 1
                ;;
        esac
    done

    if [[ -n "$do_cleanup" ]] && [[ -z "$setup_env" ]]; then
        echo "Error: --cleanup requires --setup-env, or use --cleanup-env <name> directly"
        return 1
    fi

    # Use config values if not provided via command line
    mount="${mount:-$config_testdir}"
    output="${output:-$config_output}"

    # --- setup-env: create filesystem and mount ---
    if [[ -n "$setup_env" ]]; then
        _run_setup_env "$setup_env" || return $?
        # test_env_setup.py internally ran: dtt config set testdir <mount_path>
        mount=$(load_config testdir)
        echo "Test dir updated to: $mount"
    fi

    # mlperf-specific parameter handling
    if [[ "$tool" == "mlperf" ]]; then
        # Default scenario to "all" if not specified
        scenario="${scenario:-all}"

        # Validate scenario
        case "$scenario" in
            resnet50|unet3d|cosmoflow|checkpointing|all)
                ;;
            *)
                echo "Error: Invalid mlperf scenario '$scenario'"
                echo "Valid scenarios: resnet50, unet3d, cosmoflow, checkpointing, all"
                return 1
                ;;
        esac

        # Validate scale
        case "$scale" in
            small|medium|large)
                ;;
            *)
                echo "Error: Invalid --scale value '$scale'"
                echo "Valid values: small, medium, large"
                return 1
                ;;
        esac

        # Validate file_count if provided
        if [[ -n "$file_count" ]]; then
            if [[ ! "$file_count" =~ ^[1-9][0-9]*$ ]]; then
                echo "Error: --file_count must be a positive integer, got '$file_count'"
                return 1
            fi
        fi

        # Validate gpu_count (positive integer)
        if [[ ! "$gpu_count" =~ ^[1-9][0-9]*$ ]]; then
            echo "Error: --gpu_count must be a positive integer, got '$gpu_count'"
            return 1
        fi

        # Build mlperf docker run command (replaces Phase 15 placeholder)
        # Per D-06/D-07/D-08/D-09: map CLI params to mlperf env vars
        # Per D-02/D-03/D-04: -it --rm --privileged --shm-size=8g
        # Per D-10/D-11: mount testdir→/data, output→/output

        # Verify required config is set
        if [[ -z "$mount" ]]; then
            echo "Error: Test directory not set."
            echo "Please run 'dingofs-testsuite-tool config set testdir <directory>' first."
            return 1
        fi
        if [[ -z "$output" ]]; then
            echo "Error: Output directory not set."
            echo "Please run 'dingofs-testsuite-tool config set output <directory>' first."
            return 1
        fi

        # Validate mount directory exists
        if [[ -f "$mount" ]]; then
            echo "Error: Mount path '$mount' is a file, not a directory"
            return 1
        fi
        mkdir -p "$mount"

        # Resolve mount target (handle FUSE mounts root can't access)
        local host_mount container_target container_mount
        read -r host_mount container_target container_mount <<< "$(resolve_mount_target "$mount")"

        # Create output directory if it doesn't exist
        mkdir -p "$output"

        # Build docker command with mlperf-specific flags (omit --rm in debug mode)
        local mlperf_rm_flag="--rm"
        if [[ -n "$debug" ]]; then
            mlperf_rm_flag=""
        fi
        local docker_cmd=(
            $runtime run -it $mlperf_rm_flag --privileged --net=host
            --user $(stat -c '%u:%g' "$mount")
            --shm-size=8g
            -v "${host_mount}:${container_target}"
            -v "${output}:/output"
            -e "MODELS=${scenario}"
            -e "NUM_ACCELERATORS=${gpu_count}"
            -e "ACCELERATOR_TYPE=h100"
            -e "LOOPS=1"
            -e "SUBMISSION_MODE=closed"
        )

        # Set SCALE: --file_count takes precedence over --scale (CLI-06)
        if [[ -n "$file_count" ]]; then
            docker_cmd+=("-e" "SCALE=${file_count}")
        else
            docker_cmd+=("-e" "SCALE=${scale}")
        fi

        # Mount custom scenarios directory if configured
        if [[ -n "$config_custom" ]]; then
            mkdir -p "$config_custom"
            docker_cmd+=("-v" "${config_custom}:/custom")
        fi

        # Add container entrypoint args
        docker_cmd+=("$image" "-t" "mlperf" "-s" "${scenario}" "-m" "$container_mount" "-o" "/output")

        # Print what we're about to do
        echo "Starting MLPerf Storage benchmark..."
        echo "  Image:       $image"
        echo "  Models:      $scenario"
        if [[ -n "$file_count" ]]; then
            echo "  Scale:       $file_count files (custom, overrides --scale)"
        else
            echo "  Scale:       $scale"
        fi
        echo "  GPU Count:   $gpu_count"
        echo "  Test dir:    $mount -> $container_mount"
        echo "  Output dir:  $output -> /output"
        echo ""

        # Execute
        exec "${docker_cmd[@]}"
        # exec replaces the shell process, so we never reach here
    fi

    # Validate required parameters
    if [[ -z "$mount" ]]; then
        echo "Error: Test directory not set."
        echo "Please run 'dingofs-testsuite-tool config set testdir <directory>' first."
        return 1
    fi

    if [[ -z "$output" ]]; then
        echo "Error: Output directory not set."
        echo "Please run 'dingofs-testsuite-tool config set output <directory>' first."
        return 1
    fi

    if [[ -z "$tool" ]]; then
        echo "Error: -t <tool> is required (fio, vdbench, mdtest, pjdtest, ltp, int, mlperf)"
        return 1
    fi

    # Validate mount directory exists
    if [[ -f "$mount" ]]; then
        echo "Error: Mount path '$mount' is a file, not a directory"
        return 1
    fi
    mkdir -p "$mount"

    # Resolve mount target (handle FUSE mounts root can't access)
    local host_mount container_target container_mount
    read -r host_mount container_target container_mount <<< "$(resolve_mount_target "$mount")"

    # Create output directory if it doesn't exist
    mkdir -p "$output"

    # Build docker command (omit --rm in debug mode to preserve container)
    local rm_flag="--rm"
    if [[ -n "$debug" ]]; then
        rm_flag=""
    fi

    # LTP requires rootful podman with runc and /dev/kmsg for kernel test access
    local ltp_extra_flags=()
    if [[ "$tool" == "ltp" ]]; then
        ltp_extra_flags+=("--device" "/dev/kmsg")
        if [[ "$runtime" == "podman" ]]; then
            ltp_extra_flags+=("--runtime=runc")
            runtime="sudo podman"
        fi
    fi

    local docker_cmd=(
        $runtime run $rm_flag --privileged --net=host
        --user $(stat -c '%u:%g' "$mount")
        "${ltp_extra_flags[@]}"
        -v "${host_mount}:${container_target}"
        -v "${output}:/output"
    )

    # Mount custom scenarios directory if configured
    if [[ -n "$config_custom" ]]; then
        mkdir -p "$config_custom"
        docker_cmd+=("-v" "${config_custom}:/custom")
    fi

    # Pass MDSADDR to container as environment variable for dingo CLI
    if [[ -n "$config_mdsaddr" ]]; then
        docker_cmd+=("-e" "MDSADDR=$config_mdsaddr")
    fi

    # Add host mapping for MDS if configured
    if [[ -n "$config_mdsaddr" ]]; then
        local -a added_ips=()
        # Extract unique IPs for --add-host (split by comma, extract IP from each, deduplicate)
        while IFS=',' read -ra ADDRS; do
            for addr in "${ADDRS[@]}"; do
                # Trim whitespace
                addr=$(echo "$addr" | xargs)
                [[ -n "$addr" ]] || continue
                local ip="${addr%:*}"
                # Add --add-host for this IP (avoid duplicates)
                local already_added=false
                for existing in "${added_ips[@]}"; do
                    [[ "$existing" == "$ip" ]] && already_added=true && break
                done
                if [[ "$already_added" == "false" ]]; then
                    docker_cmd+=("--add-host" "mds:${ip}")
                    added_ips+=("$ip")
                fi
            done
        done <<< "$config_mdsaddr"
    fi

    # Pass webhook_url if wechat notification enabled
    if [[ -n "$wechat" ]]; then
        local webhook_url=$(load_config webhook_url)
        docker_cmd+=("-e" "WECHAT=yes")
        docker_cmd+=("-e" "WEBHOOK_URL=$webhook_url")
    fi

    # Pass email if email notification enabled
    if [[ -n "$email_to" ]]; then
        local email_addr=$(load_config email)
        docker_cmd+=("-e" "EMAIL=yes")
        docker_cmd+=("-e" "EMAIL_TO=$email_addr")
    fi

    # Pass bs_size if specified (for fio)
    if [[ -n "$bs_size" ]]; then
        docker_cmd+=("-e" "BS_SIZE=$bs_size")
    fi

    # Build entrypoint command
    local entrypoint_cmd=(
        /entrypoint.sh
        -t "$tool"
        -m "$container_mount"
        -o /output
    )

    # Add scenario for all tools (mdtest is optional, others required)
    if [[ "$tool" == "mdtest" ]]; then
        # mdtest scenario is optional, default to "all" if not specified
        local mdtest_scenario="${scenario:-all}"
        entrypoint_cmd+=(-s "$mdtest_scenario")
    else
        # fio, vdbench, pjdtest, ltp, int all require scenario
        if [[ -z "$scenario" ]]; then
            echo "Error: -s <scenario> is required for fio, vdbench, mdtest, pjdtest, ltp, and int"
            return 1
        fi
        entrypoint_cmd+=(-s "$scenario")
    fi

    # Add np for mdtest
    if [[ "$tool" == "mdtest" ]]; then
        entrypoint_cmd+=(-n "$np")
    fi

    echo "Running testsuite with image: $image"
    echo "Mount: $mount -> $container_mount"
    echo "Output: $output -> /output"
    echo "Tool: $tool"
    if [[ -n "$scenario" ]]; then
        echo "Scenario: $scenario"
    fi
    if [[ "$tool" == "mdtest" ]]; then
        echo "NP: $np"
    fi
    echo ""

    # Execute docker command with entrypoint
    "${docker_cmd[@]}" "$image" "${entrypoint_cmd[@]}"
    local test_exit=$?

    # --- cleanup: unmount and delete filesystem ---
    if [[ -n "$do_cleanup" ]] && [[ -n "$setup_env" ]]; then
        echo ""
        echo "Cleaning up environment: $setup_env"

        local cleanup_exit=0
        (
            cd "$integration_test_dir"
            python3 -c "
import sys
sys.path.insert(0, '.')
from src.config import env_cleanup
env_cleanup('$setup_env')
"
        ) || cleanup_exit=$?

        if [[ $cleanup_exit -ne 0 ]]; then
            echo "Warning: env_cleanup failed (exit: $cleanup_exit)"
        else
            echo "Environment cleanup complete."
        fi
    fi

    return $test_exit
}

# ==============================================================================
# Cluster Commands
# ==============================================================================

cmd_cluster() {
    local subcmd="$1"

    case "$subcmd" in
        update)
            shift
            cmd_cluster_update "$@"
            ;;
        status)
            shift
            cmd_cluster_status "$@"
            ;;
        --help|-h)
            echo "Usage: dtt cluster <update|status> [options]"
            echo ""
            echo "Cluster management commands:"
            echo "  update    Update cluster to latest DingoFS image"
            echo "  status    Show cluster status"
            echo ""
            echo "Examples:"
            echo "  dtt cluster update 29 root"
            echo "  dtt cluster status 29 root"
            return 0
            ;;
        *)
            echo "Error: Unknown cluster subcommand '${subcmd:-<empty>}'"
            echo "Usage: dtt cluster <update|status> [options]"
            return 1
            ;;
    esac
}

cmd_cluster_status() {
    local cluster_id="$1"
    local deploy_user="$2"

    if [[ -z "$cluster_id" ]]; then
        echo "Error: Cluster ID required"
        echo "Usage: dtt cluster status <cluster_id> <user>"
        return 1
    fi

    if [[ -z "$deploy_user" ]]; then
        echo "Error: Deploy user required"
        echo "Usage: dtt cluster status <cluster_id> <user>"
        return 1
    fi

    # Resolve dingo path
    local dingo_path=""
    case "$cluster_id" in
        29)
            if [[ "$deploy_user" == "root" ]]; then
                dingo_path="/usr/local/bin/dingo"
            fi
            ;;
        *)
            echo "Error: Unknown cluster '$cluster_id'"
            return 1
            ;;
    esac

    if [[ -z "$dingo_path" ]]; then
        dingo_path=$(command -v dingo) || {
            echo "Error: dingo command not found in PATH"
            return 1
        }
    fi
    local DINGO_BIN="$dingo_path"

    local SUDO=""
    if [[ "$EUID" -ne 0 ]]; then
        SUDO="sudo -E"
    fi

    echo "=============================================="
    echo "Cluster $cluster_id Status"
    echo "=============================================="
    echo ""

    $SUDO $DINGO_BIN cluster status -sv
}

cmd_cluster_update() {
    # Parse -f/--file flag
    local topology_file=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--file)
                topology_file="$2"
                shift 2
                ;;
            --help|-h)
                echo "Usage: dtt cluster update <cluster_id> <user> [-f <topology_file>]"
                echo ""
                echo "Update a DingoFS cluster to the latest image."
                echo ""
                echo "Arguments:"
                echo "  cluster_id   Cluster ID (e.g. 29)"
                echo "  user         Deploy user, used to locate topology file"
                echo "               (e.g. root → /root/dingofs/deploy/...)"
                echo ""
                echo "Options:"
                echo "  -f, --file   Override topology YAML file path"
                echo ""
                echo "Examples:"
                echo "  dtt cluster update 29 root"
                echo "  dtt cluster update 29 dingofs"
                echo "  dtt cluster update 29 root -f /custom/topology.yaml"
                return 0
                ;;
            -*)
                echo "Error: Unknown option '$1'"
                return 1
                ;;
            *)
                break
                ;;
        esac
    done

    local cluster_id="$1"
    local deploy_user="$2"

    if [[ -z "$cluster_id" ]]; then
        echo "Error: Cluster ID required"
        echo "Usage: dtt cluster update <cluster_id> <user> [-f <topology_file>]"
        echo "Example: dtt cluster update 29 root"
        return 1
    fi

    if [[ -z "$deploy_user" ]]; then
        echo "Error: Deploy user required"
        echo "Usage: dtt cluster update <cluster_id> <user> [-f <topology_file>]"
        echo "Example: dtt cluster update 29 root"
        return 1
    fi

    # Determine topology file path:
    # 1) -f flag (already set above)
    # 2) built-in mapping: <user_home>/dingofs/deploy/<topology_filename>
    local dingo_path=""
    if [[ -z "$topology_file" ]]; then
        # Resolve user home directory
        local user_home
        if [[ "$deploy_user" == "root" ]]; then
            user_home="/root"
        else
            user_home="/home/$deploy_user"
        fi

        # Built-in cluster mapping
        local topo_filename=""
        case "$cluster_id" in
            29)
                topo_filename="topology-v5.2-main.yaml"
                if [[ "$deploy_user" == "root" ]]; then
                    dingo_path="/usr/local/bin/dingo"
                fi
                ;;
            *)
                echo "Error: Unknown cluster '$cluster_id'"
                echo "Supported clusters: 29"
                return 1
                ;;
        esac

        topology_file="${user_home}/dingofs/deploy/${topo_filename}"
    fi

    # Resolve dingo path if not already set by cluster mapping
    if [[ -z "$dingo_path" ]]; then
        dingo_path=$(command -v dingo) || {
            echo "Error: dingo command not found in PATH"
            return 1
        }
    fi
    local DINGO_BIN="$dingo_path"

    # Determine if we need sudo (before file check, since /root/ needs sudo to access)
    local SUDO=""
    if [[ "$EUID" -ne 0 ]]; then
        SUDO="sudo -E"
    fi

    if ! $SUDO test -f "$topology_file"; then
        echo "Error: Topology file not found: $topology_file"
        return 1
    fi

    if [[ "$EUID" -ne 0 ]]; then
        echo "Not running as root, using sudo for privileged operations"
    fi

    echo "=============================================="
    echo "Updating DingoFS Cluster $cluster_id"
    echo "=============================================="
    echo ""

    # Step 1: Set proxy
    export http_proxy=http://hproxy.it.zetyun.cn:1080
    export https_proxy=http://hproxy.it.zetyun.cn:1080

    local attempt=1
    local max_attempts=2
    local backup_file="${topology_file}.$(date +%Y%m%d_%H%M%S).bak"
    local did_backup=false

    while [[ $attempt -le $max_attempts ]]; do
        local image_tag
        local tag_label
        if [[ $attempt -eq 1 ]]; then
            tag_label="latest"
        else
            tag_label="previous"
        fi

        echo "[1/6] Fetching ${tag_label} image tag (attempt $attempt/$max_attempts)..."
        local result_index
        if [[ $attempt -eq 1 ]]; then
            result_index=0
        else
            result_index=2
        fi
        image_tag=$(curl -fsSL "https://hub.docker.com/v2/repositories/dingodatabase/dingofs/tags/?page_size=3&ordering=last_updated" | jq -r ".results[${result_index}].name")
        if [[ -z "$image_tag" || "$image_tag" == "null" ]]; then
            echo "Error: Failed to get image tag from Docker Hub"
            return 1
        fi
        echo "      Image tag: $image_tag"

        # Backup and update yaml (only on first attempt)
        if [[ "$did_backup" != "true" ]]; then
            echo "[2/6] Updating topology yaml..."
            $SUDO cp "$topology_file" "$backup_file"
            echo "      Backup saved: $backup_file"
            did_backup=true
        else
            echo "[2/6] Updating topology yaml (retry)..."
        fi
        $SUDO sed -i "0,/^  container_image:.*:/{s/\(container_image: .*:\).*/\1$image_tag/}" "$topology_file"
        echo "      Updated global.container_image in $topology_file"

        # Step 3: Commit config
        echo "[3/6] Committing cluster config..."
        $SUDO $DINGO_BIN config commit -f "$topology_file" || {
            echo "Error: Failed to commit cluster config"
            return 1
        }

        # Step 4: Stop all services
        echo "[4/6] Stopping all services..."
        $SUDO $DINGO_BIN cluster stop -f || {
            echo "Error: Failed to stop services"
            return 1
        }

        # Step 5: Clean old data
        echo "[5/6] Cleaning old data..."
        $SUDO $DINGO_BIN cluster clean -f || {
            echo "Error: Failed to clean old data"
            return 1
        }

        # Step 6: Deploy new services
        echo "[6/6] Deploying new services..."
        local deploy_output
        deploy_output=$($SUDO $DINGO_BIN cluster deploy -k 2>&1) && {
            echo ""
            echo "=============================================="
            echo "Cluster $cluster_id update complete!"
            echo "=============================================="
            echo ""
            echo "New image: harbor.zetyun.cn/dingofs/dingofs:$image_tag"
            return 0
        }

        # Deploy failed — check if it's a pull failure worth retrying
        if echo "$deploy_output" | grep -q "Error-Code: 630001" && \
           echo "$deploy_output" | grep -q "pull image failed" && \
           [[ $attempt -lt $max_attempts ]]; then
            echo "      Image pull failed (630001), retrying with previous image..."
            ((attempt++))
            continue
        fi

        echo "Error: Failed to deploy services"
        echo "$deploy_output"
        return 1
    done

    # Clear proxy
    unset http_proxy https_proxy
}

# ==============================================================================
# Setup Environment (standalone)
# ==============================================================================

_run_setup_env() {
    local setup_env="$1"
    local image runtime
    image=$(load_config image)
    runtime=$(load_config runtime)

    local repo_dir
    repo_dir=$(load_config repo)
    if [[ -z "$repo_dir" ]]; then
        repo_dir="$(cd "$(dirname "$0")" && pwd)"
    fi
    local integration_test_dir="${repo_dir}/dingofs-integration-test"

    # Custom env yaml symlink (only for local checkout)
    local cleanup_symlink=""
    local config_custom
    config_custom=$(load_config custom)
    if [[ -d "$integration_test_dir" ]] && [[ -n "$config_custom" ]] && [[ -f "$config_custom/${setup_env}.yaml" ]]; then
        ln -sf "$config_custom/${setup_env}.yaml" "$integration_test_dir/conf/env/${setup_env}.yaml"
        cleanup_symlink="$integration_test_dir/conf/env/${setup_env}.yaml"
        echo "Using custom env: $config_custom/${setup_env}.yaml"
    fi

    if [[ -d "$integration_test_dir" ]]; then
        echo "Setting up environment (local): $setup_env"
        local setup_exit=0
        (
            cd "$integration_test_dir"
            python3 tests/test_env_setup.py "$setup_env"
        ) || setup_exit=$?
    elif [[ -n "$image" ]]; then
        echo "Setting up environment (Docker): $setup_env"
        # Ensure /mnt has shared mount propagation for FUSE visibility
        sudo mount --make-rshared /mnt 2>/dev/null || true
        local docker_args=(
            $runtime run --rm --privileged --net=host
            --entrypoint ""
            -e "DINGOFS_TESTSUITE_CONFIG_DIR=$CONFIG_DIR"
            -v "$CONFIG_DIR:$CONFIG_DIR"
            -v /mnt:/mnt:shared
        )
        # Pass SSH credentials for remote host access
        if [[ -d "$HOME/.ssh" ]]; then
            docker_args+=(-v "$HOME/.ssh:/root/.ssh:ro")
        fi
        if [[ -n "${SSH_AUTH_SOCK:-}" ]] && [[ -S "$SSH_AUTH_SOCK" ]]; then
            docker_args+=(-v "$SSH_AUTH_SOCK:$SSH_AUTH_SOCK" -e "SSH_AUTH_SOCK=$SSH_AUTH_SOCK")
        fi
        # Mount custom env yaml into container if exists
        if [[ -n "$config_custom" ]] && [[ -f "$config_custom/${setup_env}.yaml" ]]; then
            docker_args+=(-v "$config_custom/${setup_env}.yaml:/dingofs-integration-test/conf/env/${setup_env}.yaml:ro")
            echo "Using custom env: $config_custom/${setup_env}.yaml"
        fi
        local setup_exit=0
        "${docker_args[@]}" "$image" \
            python3 /dingofs-integration-test/tests/test_env_setup.py "$setup_env" || setup_exit=$?
    else
        echo "Error: dingofs-integration-test not found and no image configured"
        echo "  Local path: $integration_test_dir"
        echo "  Set repo dir: dtt config set repo <path>"
        echo "  Or set image:  dtt config set image <image>"
        return 1
    fi

    [[ -n "$cleanup_symlink" ]] && rm -f "$cleanup_symlink"

    if [[ $setup_exit -ne 0 ]]; then
        echo "Error: env_setup failed (exit: $setup_exit)"
        return $setup_exit
    fi
}

_run_cleanup_env() {
    local cleanup_env="$1"
    local image runtime
    image=$(load_config image)
    runtime=$(load_config runtime)

    local repo_dir
    repo_dir=$(load_config repo)
    if [[ -z "$repo_dir" ]]; then
        repo_dir="$(cd "$(dirname "$0")" && pwd)"
    fi
    local integration_test_dir="${repo_dir}/dingofs-integration-test"

    if [[ -d "$integration_test_dir" ]]; then
        echo "Cleaning up environment (local): $cleanup_env"
        local cleanup_exit=0
        (
            cd "$integration_test_dir"
            python3 -c "
import sys
sys.path.insert(0, '.')
from src.config import env_cleanup
env_cleanup('$cleanup_env')
"
        ) || cleanup_exit=$?
    elif [[ -n "$image" ]]; then
        echo "Cleaning up environment (Docker): $cleanup_env"
        local docker_args=(
            $runtime run --rm --privileged --net=host
            --entrypoint ""
            -e "DINGOFS_TESTSUITE_CONFIG_DIR=$CONFIG_DIR"
            -v "$CONFIG_DIR:$CONFIG_DIR"
            -v /mnt:/mnt:shared
        )
        if [[ -d "$HOME/.ssh" ]]; then
            docker_args+=(-v "$HOME/.ssh:/root/.ssh:ro")
        fi
        if [[ -n "${SSH_AUTH_SOCK:-}" ]] && [[ -S "$SSH_AUTH_SOCK" ]]; then
            docker_args+=(-v "$SSH_AUTH_SOCK:$SSH_AUTH_SOCK" -e "SSH_AUTH_SOCK=$SSH_AUTH_SOCK")
        fi
        local cleanup_exit=0
        "${docker_args[@]}" "$image" \
            python3 -c "
import sys
sys.path.insert(0, '/dingofs-integration-test')
from src.config import env_cleanup
env_cleanup('$cleanup_env')
" || cleanup_exit=$?
    else
        echo "Error: dingofs-integration-test not found and no image configured"
        echo "  Set repo dir: dtt config set repo <path>"
        echo "  Or set image:  dtt config set image <image>"
        return 1
    fi

    if [[ $cleanup_exit -ne 0 ]]; then
        echo "Warning: env_cleanup failed (exit: $cleanup_exit)"
        return $cleanup_exit
    fi
    echo "Environment cleanup complete."
}

cmd_setup_env() {
    local setup_env="$1"

    if [[ -z "$setup_env" ]]; then
        echo "Error: Environment name required"
        echo "Usage: dtt --setup-env <env_name>"
        echo "Example: dtt --setup-env env_29_bug"
        return 1
    fi

    _run_setup_env "$setup_env" || return $?

    local mount
    mount=$(load_config testdir)
    echo ""
    echo "=============================================="
    echo "Environment setup complete!"
    echo "=============================================="
    echo ""
    echo "Mount point (testdir): $mount"
}

cmd_cleanup_env() {
    local cleanup_env="$1"

    if [[ -z "$cleanup_env" ]]; then
        echo "Error: Environment name required"
        echo "Usage: dtt --cleanup-env <env_name>"
        echo "Example: dtt --cleanup-env env_29_base"
        return 1
    fi

    _run_cleanup_env "$cleanup_env" || return $?
}

