_docker_cp() {
    local src="$1"
    local dst="$2"

    local output
    output=$(docker cp "$src" "$dst" 2>&1)
    if [ $? -eq 0 ]; then
        return 0
    fi

    # 容器存在但无权限访问时，用 sudo 重试
    if echo "$output" | grep -q "does not exist"; then
