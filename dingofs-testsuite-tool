  # 同时启用微信和邮件通知
  dtt -t pjdtest -s all --wechat --email

注意:
  - 配置保存在 ~/.dingofs_testsuite/
  - 如果未提供 -m/-o，则使用 'config set' 的值
  - 如果配置值未设置，系统会提示设置

EOF
}

# ==============================================================================
# Command Handlers
# ==============================================================================

cmd_config() {
    local subcommand="$1"
    shift

    case "$subcommand" in
        set)
            local key="$1"
            local value="$2"
            if [[ -z "$key" ]] || [[ -z "$value" ]]; then
                echo "Error: key and value required"
                echo "Usage: dingofs-testsuite-tool config set <key> <value>"
                echo "Keys: testdir, output, image"
                return 1
            fi

            case "$key" in
                testdir|output|image|mdsaddr|webhook_url|email)
                    save_config "$key" "$value"
                    echo "$key set to: $value"
                    ;;
                *)
                    echo "Error: Unknown config key '$key'"
                    echo "Valid keys: testdir, output, image, mdsaddr, webhook_url, email"
                    return 1
                    ;;
            esac
            ;;
        show)
            echo "Current Configuration:"
            local td=$(load_config testdir)
            local out=$(load_config output)
            local img=$(load_config image)
            local mds=$(load_config mdsaddr)
            local webhook=$(load_config webhook_url)
            local email=$(load_config email)
            echo "  testdir: ${td:-not set}"
            echo "  output:  ${out:-not set}"
            echo "  image:   ${img:-not set}"
            echo "  mdsaddr: ${mds:-not set}"
            echo "  webhook_url: ${webhook:-not set}"
            echo "  email: ${email:-not set}"
            ;;
        *)
            if [[ -z "$subcommand" ]]; then
                echo "Error: subcommand required"
                echo "Usage: dingofs-testsuite-tool config <set|show>"
                return 1
            fi
            echo "Error: Unknown config subcommand '$subcommand'"
            echo "Usage: dingofs-testsuite-tool config <set|show>"
            return 1
            ;;
    esac
}

cmd_debug() {
    local image=$(load_config image)
    local testdir=$(load_config testdir)
    local output=$(load_config output)
    local mdsaddr=$(load_config mdsaddr)

    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dingofs-testsuite-tool config set image <image>' first."
        return 1
    fi

    echo "Starting debug shell with image: $image"
    echo "Testdir: ${testdir:-<not set>}"
    echo "Output: ${output:-<not set>}"
    echo "MDSAddr: ${mdsaddr:-<not set>}"
    echo ""
    echo "Type 'exit' to leave the container"
    echo ""

    local docker_cmd=("docker" "run" "-it" "--rm" "--privileged" "--entrypoint" "/bin/bash")

    if [[ -n "$testdir" ]]; then
        docker_cmd+=("-v" "${testdir}:/data")
    fi

    if [[ -n "$output" ]]; then
        docker_cmd+=("-v" "${output}:/output")
    fi

    if [[ -n "$mdsaddr" ]]; then
        local -a added_ips=()
        # Extract unique IPs for --add-host (split by comma, extract IP from each, deduplicate)
        while IFS=',' read -ra ADDRS; do
            for addr in "${ADDRS[@]}"; do
                # Trim whitespace
                addr=$(echo "$addr" | xargs)
                [[ -n "$addr" ]] || continue
                local ip="${addr%:*}"
                # Add --add-host for this IP (avoid duplicates)
                local already_added=false
                for existing in "${added_ips[@]}"; do
                    [[ "$existing" == "$ip" ]] && already_added=true && break
                done
                if [[ "$already_added" == "false" ]]; then
                    docker_cmd+=("--add-host" "mds:${ip}")
                    added_ips+=("$ip")
                fi
            done
        done <<< "$mdsaddr"
        # Pass MDSADDR to container as environment variable for dingo CLI
        docker_cmd+=("-e" "MDSADDR=$mdsaddr")
    fi

    docker_cmd+=("$image")

    "${docker_cmd[@]}"
}

run_docker_help() {
    local tool="$1"
    local image=$(load_config image)

    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dingofs-testsuite-tool config set image <image>' first."
        return 1
    fi

    docker run --rm "$image" -t "$tool" --help
}

run_testsuite() {
    local image=$(load_config image)
    local config_testdir=$(load_config testdir)
    local config_output=$(load_config output)
    local config_mdsaddr=$(load_config mdsaddr)

    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dingofs-testsuite-tool config set image <image>' first."
        echo ""
        echo "Usage:"
        echo "  dingofs-testsuite-tool config set image localhost/dingofs-testsuite-tools:latest"
        return 1
    fi

    # Parse arguments
    local mount="" output="" tool="" scenario="" np="${NP:-16}"
    local wechat="" email_to=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--mount)
                mount="$2"
                shift 2
                ;;
            -o|--output)
                output="$2"
                shift 2
                ;;
            -t|--tool)
                tool="$2"
                shift 2
                ;;
            -s|--scenario)
                scenario="$2"
                shift 2
                ;;
            -n|--np)
                np="$2"
                shift 2
                ;;
            --wechat)
                wechat="yes"
                shift
                ;;
            --email)
                email_to="yes"
                shift
                ;;
            --help|-h)
                # Check if tool is already set, show tool-specific help
                if [[ -n "$tool" ]]; then
                    run_docker_help "$tool"
                    exit $?
                else
                    show_help
                    exit 0
                fi
                ;;
            *)
                echo "Error: Unknown option '$1'"
                return 1
                ;;
        esac
    done

    # Use config values if not provided via command line
    mount="${mount:-$config_testdir}"
    output="${output:-$config_output}"

    # Validate required parameters
    if [[ -z "$mount" ]]; then
        echo "Error: Test directory not set."
        echo "Please run 'dingofs-testsuite-tool config set testdir <directory>' first."
        return 1
    fi

    if [[ -z "$output" ]]; then
        echo "Error: Output directory not set."
        echo "Please run 'dingofs-testsuite-tool config set output <directory>' first."
        return 1
    fi

    if [[ -z "$tool" ]]; then
        echo "Error: -t <tool> is required (fio, vdbench, mdtest, pjdtest, ltp, int)"
        return 1
    fi

    # Validate mount directory exists
    if [[ ! -d "$mount" ]]; then
        echo "Error: Mount directory '$mount' does not exist"
        return 1
    fi

    # Create output directory if it doesn't exist
    mkdir -p "$output"

    # Build docker command
    local docker_cmd=(
        docker run --rm --privileged
        -v "${mount}:/data"
        -v "${output}:/output"
    )

    # Pass MDSADDR to container as environment variable for dingo CLI
    if [[ -n "$config_mdsaddr" ]]; then
        docker_cmd+=("-e" "MDSADDR=$config_mdsaddr")
    fi

    # Add host mapping for MDS if configured
    if [[ -n "$config_mdsaddr" ]]; then
        local -a added_ips=()
        # Extract unique IPs for --add-host (split by comma, extract IP from each, deduplicate)
        while IFS=',' read -ra ADDRS; do
            for addr in "${ADDRS[@]}"; do
                # Trim whitespace
                addr=$(echo "$addr" | xargs)
                [[ -n "$addr" ]] || continue
                local ip="${addr%:*}"
                # Add --add-host for this IP (avoid duplicates)
                local already_added=false
                for existing in "${added_ips[@]}"; do
                    [[ "$existing" == "$ip" ]] && already_added=true && break
                done
                if [[ "$already_added" == "false" ]]; then
                    docker_cmd+=("--add-host" "mds:${ip}")
                    added_ips+=("$ip")
                fi
            done
        done <<< "$config_mdsaddr"
    fi

    # Pass webhook_url if wechat notification enabled
    if [[ -n "$wechat" ]]; then
        local webhook_url=$(load_config webhook_url)
        docker_cmd+=("-e" "WECHAT=yes")
        docker_cmd+=("-e" "WEBHOOK_URL=$webhook_url")
    fi

    # Pass email if email notification enabled
    if [[ -n "$email_to" ]]; then
        local email_addr=$(load_config email)
        docker_cmd+=("-e" "EMAIL=yes")
        docker_cmd+=("-e" "EMAIL_TO=$email_addr")
    fi

    # Build entrypoint command
    local entrypoint_cmd=(
        /entrypoint.sh
        -t "$tool"
        -m /data
        -o /output
    )

    # Add scenario for all tools (mdtest is optional, others required)
    if [[ "$tool" == "mdtest" ]]; then
        # mdtest scenario is optional
        [[ -n "$scenario" ]] && entrypoint_cmd+=(-s "$scenario")
    else
        # fio, vdbench, pjdtest, ltp, int all require scenario
        if [[ -z "$scenario" ]]; then
            echo "Error: -s <scenario> is required for fio, vdbench, mdtest, pjdtest, ltp, and int"
            return 1
        fi
        entrypoint_cmd+=(-s "$scenario")
    fi

    # Add np for mdtest
    if [[ "$tool" == "mdtest" ]]; then
        entrypoint_cmd+=(-n "$np")
    fi

    echo "Running testsuite with image: $image"
    echo "Mount: $mount -> /data"
    echo "Output: $output -> /output"
    echo "Tool: $tool"
    if [[ -n "$scenario" ]]; then
        echo "Scenario: $scenario"
    fi
    if [[ "$tool" == "mdtest" ]]; then
        echo "NP: $np"
    fi
    echo ""

    # Execute docker command with entrypoint
    "${docker_cmd[@]}" "$image" "${entrypoint_cmd[@]}"
}

# ==============================================================================
# Main Entry Point
# ==============================================================================

dingofs-testsuite-tool() {
    local command="$1"

    case "$command" in
        config)
            shift
            cmd_config "$@"
            ;;
        debug)
            cmd_debug
            ;;
        help|--help|-h)
            show_help
            ;;
        -t|--tool|-s|--scenario|-n|--np|-m|--mount|-o|--output|--wechat|--email)
            # Handle case where command starts with options (no explicit command)
            run_testsuite "$@"
            ;;
        *)
            if [[ -z "$command" ]]; then
                echo "Error: No command specified"
                echo "Run 'dingofs-testsuite-tool help' for usage information"
                return 1
            fi
            echo "Error: Unknown command '$command'"
            echo "Run 'dingofs-testsuite-tool help' for usage information"
            return 1
            ;;
    esac
}

# If script is executed directly (not sourced), run the command
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    dingofs-testsuite-tool "$@"
fi

# Shortcut alias (when sourced)
alias dtt='dingofs-testsuite-tool'