    echo "用法: $0 <fsname> <path> [capacity] [inodes]"
    echo "  fsname     : 文件系统名称"
    echo "  path       : 要设置配额的目录路径（例如 /）"
    echo "  capacity   : 容量配额，默认 10GiB（可选）"
    echo "  inodes     : inode 配额，默认 10（可选）"
    echo "示例: $0 trash-test-1 /                # 使用默认配额 10GiB 和 10"
    echo "示例: $0 trash-test-1 / 5GiB           # capacity=5GiB, inodes=10"
    echo "示例: $0 trash-test-1 / 5GiB 200       # capacity=5GiB, inodes=200"
    exit 1
fi

FSNAME="$1"
PATH_DIR="$2"
CAPACITY="${3:-10}"
INODES="${4:-10}"

__DINGO_PATH__ fs quota set \
    --fsname "${FSNAME}" \
    --path "${PATH_DIR}" \
    --capacity "${CAPACITY}" \
    --inodes "${INODES}" \
    --mdsaddr __MDS_ADDR__
TOOL_EOF
            ;;
        restoretrash)
            cat <<'TOOL_EOF'
#!/bin/bash

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
    echo "用法: $0 <fs_name> <hours_bucket> <put_back>"
    echo "示例: $0 test1 2026-06-17-02 false"
    exit 1
fi

FS_NAME="$(echo "$1" | xargs)"
HOURS="$2"
PUT_BACK="${3:-true}"

echo "正在查询文件系统列表..."
FS_LIST=$(__DINGO_PATH__ fs list --mdsaddr __MDS_ADDR__ 2>&1 | tee /dev/tty)

if [ $? -ne 0 ]; then
    echo "错误: '__DINGO_PATH__ fs list' 执行失败"
    exit 1
fi

FS_ID=$(echo "$FS_LIST" | awk -v target="$FS_NAME" '
BEGIN { FS="[|]"; found=0 }
{
    if ($0 ~ /^\+/ || NF < 10) next
    gsub(/^[ \t]+|[ \t]+$/, "", $2)
    gsub(/^[ \t]+|[ \t]+$/, "", $3)
    if ($3 == target) {
        print $2
        found=1
        exit
    }
}
END {
    if (!found) exit 1
}
')

if [ -z "$FS_ID" ]; then
    echo "错误: 未找到名称为 '${FS_NAME}' 的文件系统。"
    echo "以下是解析出的所有文件系统名称（用于核对）："
    echo "$FS_LIST" | awk -F'[|]' '
        $0 !~ /^\+/ && NF>=10 {
            gsub(/^[ \t]+|[ \t]+$/, "", $3)
            if($3!="") print "  '"'"'" $3 "'"'"'"
        }
    '
    exit 1
fi

echo "找到 FSID = ${FS_ID}"

echo "正在执行恢复操作..."
sudo __USER_HOME__/.dingo/components/dingo-mds-client/main/dingo-mds-client \
    --mds_addr=__MDS_ADDR__ \
    --cmd=restoretrash \
    --fs_id="${FS_ID}" \
    --hours="${HOURS}" \
    --put_back="${PUT_BACK}" \
    --restore_threads=16
TOOL_EOF
