OUTPUT_FILE="$CONFIG_DIR/output"
IMAGE_FILE="$CONFIG_DIR/image"
MDSADDR_FILE="$CONFIG_DIR/mdsaddr"
WEBHOOK_URL_FILE="$CONFIG_DIR/webhook_url"
EMAIL_FILE="$CONFIG_DIR/email"
RUNTIME_FILE="$CONFIG_DIR/runtime"
INTENV_FILE="$CONFIG_DIR/int_env"
CUSTOM_FILE="$CONFIG_DIR/custom"
REPO_FILE="$CONFIG_DIR/repo"

# Default image
DEFAULT_IMAGE="localhost/dingofs-testsuite-tools:latest"

# Default webhook URL for WeChat
DEFAULT_WEBHOOK_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=9051ba90-dd37-4023-b49f-5db8ce78ac31"

# Default email
DEFAULT_EMAIL="daigy@zetyun.com"

# Ensure config directory exists
mkdir -p "$CONFIG_DIR"

# ==============================================================================
# Helper Functions
# ==============================================================================

load_config() {
    local key="$1"
    local file=""
    local default=""
    case "$key" in
        testdir)   file="$TESTDIR_FILE"      default="" ;;
        output)    file="$OUTPUT_FILE"       default="" ;;
        image)     file="$IMAGE_FILE"        default="$DEFAULT_IMAGE" ;;
        mdsaddr)   file="$MDSADDR_FILE"      default="" ;;
        webhook_url) file="$WEBHOOK_URL_FILE" default="$DEFAULT_WEBHOOK_URL" ;;
        email)     file="$EMAIL_FILE"        default="$DEFAULT_EMAIL" ;;
        runtime)   file="$RUNTIME_FILE"      default="docker" ;;
        int_env)   file="$INTENV_FILE"       default="env_126_smoke" ;;
        custom)    file="$CUSTOM_FILE"       default="" ;;
        repo)      file="$REPO_FILE"         default="" ;;
    esac
    if [[ -f "$file" ]]; then
        local val
        IFS= read -r val < "$file" 2>/dev/null && printf '%s' "$val" || printf '%s' "$default"
    else
        printf '%s' "$default"
    fi
}

save_config() {
    local key="$1"
    local value="$2"
    case "$key" in
        testdir)
            echo "$value" > "$TESTDIR_FILE"
            ;;
        output)
            echo "$value" > "$OUTPUT_FILE"
            ;;
        image)
            echo "$value" > "$IMAGE_FILE"
            ;;
        mdsaddr)
            echo "$value" > "$MDSADDR_FILE"
            ;;
        webhook_url)
            echo "$value" > "$WEBHOOK_URL_FILE"
            ;;
        email)
            echo "$value" > "$EMAIL_FILE"
            ;;
        runtime)
            echo "$value" > "$RUNTIME_FILE"
            ;;
        int_env)
            echo "$value" > "$INTENV_FILE"
            ;;
        custom)
            echo "$value" > "$CUSTOM_FILE"
            ;;
        repo)
            echo "$value" > "$REPO_FILE"
            ;;
    esac
}

list_docker_images() {
    local runtime=$(load_config runtime)
    echo "Available dingofs-testsuite-tools images:"
    $runtime images --format "{{.Repository}}:{{.Tag}}" 2>/dev/null | grep -E "dingofs-testsuite-tools|testsuite-tools" || echo "  (no matching images found)"
    echo ""
    echo "All Docker images:"
    $runtime images --format "  {{.Repository}}:{{.Tag}}" 2>/dev/null
}


# Check if a path is on FUSE and inaccessible to root (Docker daemon).
# Also catches stale/disconnected mounts where stat fails entirely.
_is_fuse_blocked() {
    local path="$1"
    local fstype
    fstype=$(stat -f -c '%T' "$path" 2>/dev/null || echo "")
    # FUSE filesystem, or stat failed entirely (stale mount)
    if [[ "$fstype" == "fuseblk" ]] || [[ -z "$fstype" ]]; then
        ! sudo test -r "$path" 2>/dev/null
        return $?
    fi
    return 1
}

# Resolve mount mapping for FUSE mounts that Docker daemon can't access.
# Output: host_path container_target container_mount_path
#   host_path          - bind-mount source (parent dir for FUSE, original path otherwise)
#   container_target   - bind-mount target (always /data)
#   container_mount_path - entrypoint -m value (/data or /data/subdir for FUSE)
resolve_mount_target() {
    local mount_path="$1"
    local container_base="${2:-/data}"

    if _is_fuse_blocked "$mount_path"; then
        local subdir
        subdir=$(basename "$mount_path")
        local parent_dir
        parent_dir=$(dirname "$mount_path")
        echo "$parent_dir" "$container_base" "${container_base}/${subdir}"
    else
        echo "$mount_path" "$container_base" "$container_base"
    fi
}

