# ==============================================================================
# Command Handlers
# ==============================================================================

cmd_daily() {
    local image=$(load_config image)
    local config_testdir=$(load_config testdir)
    local config_output=$(load_config output)
    local config_mdsaddr=$(load_config mdsaddr)
    local runtime=$(load_config runtime)

    # Handle --help before config checks
    if [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
        show_daily_help
        return 0
    fi

    # Parse flags
    local env="126"
    local email_to="dingofs@zetyun.com"
    local wechat=""
    local debug=""
    local report_path=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --env)
                env="$2"
                shift 2
                ;;
            --email)
                if [[ -n "$2" ]] && [[ "$2" != -* ]]; then
                    email_to="$2"
                    shift 2
                else
                    email_to="dingofs@zetyun.com"
                    shift
                fi
                ;;
            --wechat)
                wechat="yes"
                shift
                ;;
            --debug)
                debug="yes"
                shift
                ;;
            --report-path)
                report_path="$2"
                shift 2
                ;;
            --help|-h)
                show_daily_help
                return 0
                ;;
            *)
                echo "Error: Unknown option '$1'"
                echo "Run 'dtt daily --help' for usage information"
                return 1
                ;;
        esac
    done

    # Validate image
    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dtt config set image <image>' first."
        return 1
    fi

    # Validate/test directory
    local mount="${config_testdir}"
    if [[ -n "$mount" ]]; then
        if [[ -f "$mount" ]]; then
            echo "Error: Mount path '$mount' is a file, not a directory"
            return 1
        fi
        mkdir -p "$mount"
    fi

    # Resolve mount target (FUSE workaround)
    local host_mount container_target container_mount
    if [[ -n "$mount" ]]; then
        read -r host_mount container_target container_mount <<< "$(resolve_mount_target "$mount")"
    fi

    # Validate/create output directory
    local output="${config_output}"
    if [[ -z "$output" ]]; then
        echo "Error: Output directory not set."
        echo "Please run 'dtt config set output <directory>' first."
        return 1
    fi
    mkdir -p "$output"

    # commit_info.yaml file path
    local commit_info_file="/home/jenkins/jenkins_workdir/script-main/commit_info.yaml"

    # Build docker/podman command
    local rm_flag="--rm"
    if [[ -n "$debug" ]]; then
        rm_flag=""
    fi

    local docker_cmd=(
        $runtime run $rm_flag --privileged --net=host
        --entrypoint /bin/bash
    )

    # Add --user if testdir is set (for FUSE access)
    if [[ -n "$mount" ]]; then
        docker_cmd+=("--user" "$(stat -c '%u:%g' "$mount")")
        docker_cmd+=("-v" "${host_mount}:${container_target}")
    fi

    docker_cmd+=("-v" "${output}:/output")

    # Mount report path if specified
    if [[ -n "$report_path" ]]; then
        mkdir -p "$report_path"
        docker_cmd+=("-v" "${report_path}:/allure-report")
    fi

    # Mount commit_info.yaml if it exists
    if [[ -f "$commit_info_file" ]]; then
        docker_cmd+=("-v" "${commit_info_file}:${commit_info_file}:ro")
    else
        echo "Warning: commit_info.yaml not found at $commit_info_file"
    fi

    # MDS address
    if [[ -n "$config_mdsaddr" ]]; then
        docker_cmd+=("-e" "MDSADDR=$config_mdsaddr")
        local -a added_ips=()
        while IFS=',' read -ra ADDRS; do
            for addr in "${ADDRS[@]}"; do
                addr=$(echo "$addr" | xargs)
                [[ -n "$addr" ]] || continue
                local ip="${addr%:*}"
                local already_added=false
                for existing in "${added_ips[@]}"; do
                    [[ "$existing" == "$ip" ]] && already_added=true && break
                done
                if [[ "$already_added" == "false" ]]; then
                    docker_cmd+=("--add-host" "mds:${ip}")
                    added_ips+=("$ip")
                fi
            done
        done <<< "$config_mdsaddr"
    fi

    # Build the python command
    local py_cmd="cd /dingofs-integration-test && python3 run_tests.py \
        client --env env_${env}_smoke --run-level smoke \
        cache_node --env env_${env}_smoke --run-level smoke \
        quota --env env_${env}_quota \
        basic_file_operation --env env_${env}_smoke \
        mount_subdir --env env_${env}_mount_subdir \
        trash --env env_${env}_trash \
        --commit_info_file_path ${commit_info_file} \
        --reruns 5 --email ${email_to}"

    if [[ -n "$wechat" ]]; then
        py_cmd="${py_cmd} --wechat"
    fi

    if [[ -n "$report_path" ]]; then
        py_cmd="${py_cmd} --report-path /allure-report"
    else
        py_cmd="${py_cmd} --report-path /output"
    fi

    docker_cmd+=("$image" "-c" "$py_cmd")

    # Print execution info
    echo "Starting daily integration test..."
    echo "  Image:       $image"
    echo "  Environment: $env"
    echo "  Email:       $email_to"
    echo "  WeChat:      ${wechat:-no}"
    if [[ -n "$mount" ]]; then
        echo "  Test dir:    $mount -> $container_mount"
    fi
    echo "  Output dir:  $output -> /output"
    if [[ -n "$report_path" ]]; then
        echo "  Report path: $report_path -> /allure-report"
    fi
    if [[ -n "$debug" ]]; then
        echo "  Debug:       container will be preserved"
    fi
    echo ""

    "${docker_cmd[@]}"
}

cmd_smoke() {
    local image=$(load_config image)
    local config_testdir=$(load_config testdir)
    local config_output=$(load_config output)
    local config_mdsaddr=$(load_config mdsaddr)
    local runtime=$(load_config runtime)
    local int_env=$(load_config int_env)

    # Handle --help before config checks
    if [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
        show_smoke_help
        return 0
    fi

    # Parse flags: --wechat, --email, --debug, --exclude, --help
    local wechat=""
    local email_to=""
    local debug=""
    local exclude=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --wechat)
                wechat="yes"
                shift
                ;;
            --email)
                email_to="yes"
                shift
                ;;
            --debug)
                debug="yes"
                shift
                ;;
            --exclude)
                exclude="$2"
                shift 2
                ;;
            --help|-h)
                show_smoke_help
                return 0
                ;;
            *)
                echo "Error: Unknown option '$1'"
                echo "Run 'dtt smoke --help' for usage information"
                return 1
                ;;
        esac
    done

    # Validate image is configured
    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dtt config set image <image>' first."
        return 1
    fi

    # Validate test directory
    local mount="${config_testdir}"
    if [[ -z "$mount" ]]; then
        echo "Error: Test directory not set."
        echo "Please run 'dtt config set testdir <directory>' first."
        return 1
    fi
    if [[ -f "$mount" ]]; then
        echo "Error: Mount path '$mount' is a file, not a directory"
        return 1
    fi
    mkdir -p "$mount"

    # Resolve mount target (handle FUSE mounts root can't access)
    local host_mount container_target container_mount
    read -r host_mount container_target container_mount <<< "$(resolve_mount_target "$mount")"

    # Validate/create output directory
    local output="${config_output}"
    if [[ -z "$output" ]]; then
        echo "Error: Output directory not set."
        echo "Please run 'dtt config set output <directory>' first."
        return 1
    fi
    mkdir -p "$output"

    # Build docker/podman command (omit --rm in debug mode)
    local rm_flag="--rm"
    if [[ -n "$debug" ]]; then
        rm_flag=""
    fi

    local docker_cmd=(
        $runtime run $rm_flag --privileged --net=host
        --user $(stat -c '%u:%g' "$mount")
        -v "${host_mount}:${container_target}"
        -v "${output}:/output"
    )

    # Pass MDS address if configured (needed for integration test context)
    if [[ -n "$config_mdsaddr" ]]; then
        docker_cmd+=("-e" "MDSADDR=$config_mdsaddr")
        # Add --add-host entries for MDS IPs
        local -a added_ips=()
        while IFS=',' read -ra ADDRS; do
            for addr in "${ADDRS[@]}"; do
                addr=$(echo "$addr" | xargs)
                [[ -n "$addr" ]] || continue
                local ip="${addr%:*}"
                local already_added=false
                for existing in "${added_ips[@]}"; do
                    [[ "$existing" == "$ip" ]] && already_added=true && break
                done
                if [[ "$already_added" == "false" ]]; then
                    docker_cmd+=("--add-host" "mds:${ip}")
                    added_ips+=("$ip")
                fi
            done
        done <<< "$config_mdsaddr"
    fi

    # WeChat notification env vars
    if [[ -n "$wechat" ]]; then
        local webhook_url=$(load_config webhook_url)
        docker_cmd+=("-e" "WECHAT=yes")
        docker_cmd+=("-e" "WEBHOOK_URL=$webhook_url")
    fi

    # Email notification env vars
    if [[ -n "$email_to" ]]; then
        local email_addr=$(load_config email)
        docker_cmd+=("-e" "EMAIL=yes")
        docker_cmd+=("-e" "EMAIL_TO=$email_addr")
    fi

    # Integration test environment
    docker_cmd+=("-e" "INT_ENV=$int_env")

    # Smoke exclude list
    if [[ -n "$exclude" ]]; then
        docker_cmd+=("-e" "SMOKE_EXCLUDE=$exclude")
    fi

    # Print execution info
    echo "Starting smoke test suite..."
    echo "  Image:       $image"
    echo "  Test dir:    $mount -> $container_mount"
    echo "  Output dir:  $output -> /output"
    if [[ -n "$wechat" ]]; then
        echo "  WeChat:      enabled"
    fi
    if [[ -n "$email_to" ]]; then
        echo "  Email:       enabled"
    fi
    if [[ -n "$debug" ]]; then
        echo "  Debug:       container will be preserved"
    fi
    echo ""

    # Execute: run container with -t smoke, mounting test/output dirs
    "${docker_cmd[@]}" "$image" /entrypoint.sh -t smoke -m "$container_mount" -o /output
}

cmd_config() {
    local subcommand="$1"
    shift

    case "$subcommand" in
        set)
            local key="$1"
            local value="$2"
            if [[ -z "$key" ]] || [[ -z "$value" ]]; then
                echo "Error: key and value required"
                echo "Usage: dingofs-testsuite-tool config set <key> <value>"
                echo "Keys: testdir, output, image"
                return 1
            fi

            case "$key" in
                testdir|output|image|mdsaddr|webhook_url|email|runtime|int_env)
                    save_config "$key" "$value"
                    echo "$key set to: $value"
                    ;;
                *)
                    echo "Error: Unknown config key '$key'"
                    echo "Valid keys: testdir, output, image, mdsaddr, webhook_url, email, runtime, int_env"
                    return 1
                    ;;
            esac
            ;;
        show)
            echo "Current Configuration:"
            local td=$(load_config testdir)
            local out=$(load_config output)
            local img=$(load_config image)
            local mds=$(load_config mdsaddr)
            local webhook=$(load_config webhook_url)
            local email=$(load_config email)
            local runtime=$(load_config runtime)
            local int_env=$(load_config int_env)
            echo "  testdir: ${td:-not set}"
            echo "  output:  ${out:-not set}"
            echo "  image:   ${img:-not set}"
            echo "  mdsaddr: ${mds:-not set}"
            echo "  webhook_url: ${webhook:-not set}"
            echo "  email: ${email:-not set}"
            echo "  runtime: ${runtime:-docker}"
            echo "  int_env: ${int_env:-env_126_smoke}"
            ;;
        *)
            if [[ -z "$subcommand" ]]; then
                echo "Error: subcommand required"
                echo "Usage: dingofs-testsuite-tool config <set|show>"
                return 1
            fi
            echo "Error: Unknown config subcommand '$subcommand'"
            echo "Usage: dingofs-testsuite-tool config <set|show>"
            return 1
            ;;
    esac
}

