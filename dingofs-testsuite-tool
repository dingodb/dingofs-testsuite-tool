_run_setup_env() {
    local setup_env="$1"
    local image runtime
    image=$(load_config image)
    runtime=$(load_config runtime)

    local repo_dir
    repo_dir=$(load_config repo)
    if [[ -z "$repo_dir" ]]; then
        repo_dir="$(cd "$(dirname "$0")" && pwd)"
    fi
    local integration_test_dir="${repo_dir}/dingofs-integration-test"

    # Custom env yaml symlink (only for local checkout)
    local cleanup_symlink=""
    local config_custom
    config_custom=$(load_config custom)
    if [[ -d "$integration_test_dir" ]] && [[ -n "$config_custom" ]] && [[ -f "$config_custom/${setup_env}.yaml" ]]; then
        ln -sf "$config_custom/${setup_env}.yaml" "$integration_test_dir/conf/env/${setup_env}.yaml"
        cleanup_symlink="$integration_test_dir/conf/env/${setup_env}.yaml"
        echo "Using custom env: $config_custom/${setup_env}.yaml"
    fi

    if [[ -d "$integration_test_dir" ]]; then
        echo "Setting up environment (local): $setup_env"
        local setup_exit=0
        (
            cd "$integration_test_dir"
            python3 tests/test_env_setup.py "$setup_env"
        ) || setup_exit=$?
    elif [[ -n "$image" ]]; then
        echo "Setting up environment (Docker): $setup_env"
        # Ensure /mnt has shared mount propagation for FUSE visibility
        sudo mount --make-rshared /mnt 2>/dev/null || true
        local docker_args=(
            $runtime run --rm --privileged --net=host
            --entrypoint ""
            -e "DINGOFS_TESTSUITE_CONFIG_DIR=$CONFIG_DIR"
            -v "$CONFIG_DIR:$CONFIG_DIR"
            -v /mnt:/mnt:rshared
        )
        # Pass SSH credentials for remote host access
        if [[ -d "$HOME/.ssh" ]]; then
            docker_args+=(-v "$HOME/.ssh:/root/.ssh:ro")
        fi
        if [[ -n "${SSH_AUTH_SOCK:-}" ]] && [[ -S "$SSH_AUTH_SOCK" ]]; then
            docker_args+=(-v "$SSH_AUTH_SOCK:$SSH_AUTH_SOCK" -e "SSH_AUTH_SOCK=$SSH_AUTH_SOCK")
        fi
        # Mount updated test_env_setup.py if available locally (fixes for image's stale version)
        local local_test_script=""
        # Try repo_dir first, then git toplevel from script dir, then common paths
        for candidate in \
            "$integration_test_dir/tests/test_env_setup.py" \
            "$(cd "$(dirname "$0")" && git rev-parse --show-toplevel 2>/dev/null)/dingofs-integration-test/tests/test_env_setup.py"; do
            if [[ -f "$candidate" ]]; then
                local_test_script="$candidate"
                break
            fi
        done
        if [[ -n "$local_test_script" ]]; then
            docker_args+=(-v "$local_test_script:/dingofs-integration-test/tests/test_env_setup.py:ro")
        fi

        # Mount custom env yaml into container if exists
        if [[ -n "$config_custom" ]] && [[ -f "$config_custom/${setup_env}.yaml" ]]; then
            docker_args+=(-v "$config_custom/${setup_env}.yaml:/dingofs-integration-test/conf/env/${setup_env}.yaml:ro")
            echo "Using custom env: $config_custom/${setup_env}.yaml"
        fi
        local setup_exit=0
        "${docker_args[@]}" "$image" \
            python3 /dingofs-integration-test/tests/test_env_setup.py "$setup_env" || setup_exit=$?
    else
        echo "Error: dingofs-integration-test not found and no image configured"
        echo "  Local path: $integration_test_dir"
        echo "  Set repo dir: dtt config set repo <path>"
        echo "  Or set image:  dtt config set image <image>"
        return 1
    fi

    [[ -n "$cleanup_symlink" ]] && rm -f "$cleanup_symlink"

    if [[ $setup_exit -ne 0 ]]; then
        echo "Error: env_setup failed (exit: $setup_exit)"
        return $setup_exit
    fi
}

_run_cleanup_env() {
    local cleanup_env="$1"
    local image runtime
    image=$(load_config image)
    runtime=$(load_config runtime)

    local repo_dir
    repo_dir=$(load_config repo)
    if [[ -z "$repo_dir" ]]; then
        repo_dir="$(cd "$(dirname "$0")" && pwd)"
    fi
    local integration_test_dir="${repo_dir}/dingofs-integration-test"

    if [[ -d "$integration_test_dir" ]]; then
        echo "Cleaning up environment (local): $cleanup_env"
        local cleanup_exit=0
        (
            cd "$integration_test_dir"
            python3 -c "
import sys
sys.path.insert(0, '.')
from src.config import env_cleanup
env_cleanup('$cleanup_env')
"
        ) || cleanup_exit=$?
    elif [[ -n "$image" ]]; then
        echo "Cleaning up environment (Docker): $cleanup_env"
        local docker_args=(
            $runtime run --rm --privileged --net=host
            --entrypoint ""
            -e "DINGOFS_TESTSUITE_CONFIG_DIR=$CONFIG_DIR"
            -v "$CONFIG_DIR:$CONFIG_DIR"
            -v /mnt:/mnt:rshared
        )
        if [[ -d "$HOME/.ssh" ]]; then
            docker_args+=(-v "$HOME/.ssh:/root/.ssh:ro")
        fi
        if [[ -n "${SSH_AUTH_SOCK:-}" ]] && [[ -S "$SSH_AUTH_SOCK" ]]; then
            docker_args+=(-v "$SSH_AUTH_SOCK:$SSH_AUTH_SOCK" -e "SSH_AUTH_SOCK=$SSH_AUTH_SOCK")
        fi
        local cleanup_exit=0
        "${docker_args[@]}" "$image" \
            python3 -c "
import sys
sys.path.insert(0, '/dingofs-integration-test')
from src.config import env_cleanup
env_cleanup('$cleanup_env')
" || cleanup_exit=$?
    else
        echo "Error: dingofs-integration-test not found and no image configured"
        echo "  Set repo dir: dtt config set repo <path>"
        echo "  Or set image:  dtt config set image <image>"
        return 1
    fi

    if [[ $cleanup_exit -ne 0 ]]; then
        echo "Warning: env_cleanup failed (exit: $cleanup_exit)"
        return $cleanup_exit
    fi
    echo "Environment cleanup complete."
}

cmd_setup_env() {
    local setup_env="$1"

    if [[ -z "$setup_env" ]]; then
        echo "Error: Environment name required"
        echo "Usage: dtt --setup-env <env_name>"
        echo "Example: dtt --setup-env env_29_bug"
        return 1
    fi

    # Capture output to parse DINGOFS_TEMP_MOUNTDIR (tee for real-time display)
    local setup_log _setup_rc
    setup_log=$(mktemp)
    _run_setup_env "$setup_env" 2>&1 | tee "$setup_log" || true
    _setup_rc=${PIPESTATUS[0]}

    if [[ $_setup_rc -ne 0 ]]; then
        rm -f "$setup_log"
        return $_setup_rc
    fi

    # Parse mount dir from output and update testdir config
    local mount_path
    mount_path=$(grep -oP 'export DINGOFS_TEMP_MOUNTDIR=\K.*' "$setup_log" | tail -1)
    rm -f "$setup_log"

    if [[ -n "$mount_path" ]]; then
        save_config testdir "$mount_path"
        echo ""
        echo "=============================================="
        echo "Environment setup complete!"
        echo "=============================================="
        echo ""
        echo "Testdir updated: $mount_path"
    else
        local mount
        mount=$(load_config testdir)
        echo ""
        echo "=============================================="
        echo "Environment setup complete!"
        echo "=============================================="
        echo ""
        echo "Mount point (testdir): $mount"
    fi
}

cmd_cleanup_env() {
    local cleanup_env="$1"

    if [[ -z "$cleanup_env" ]]; then
        echo "Error: Environment name required"
        echo "Usage: dtt --cleanup-env <env_name>"
        echo "Example: dtt --cleanup-env env_29_base"
        return 1
    fi

    _run_cleanup_env "$cleanup_env" || return $?
}

