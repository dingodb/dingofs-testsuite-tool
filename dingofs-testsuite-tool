TESTDIR_FILE="$CONFIG_DIR/testdir"
OUTPUT_FILE="$CONFIG_DIR/output"
IMAGE_FILE="$CONFIG_DIR/image"
MDSADDR_FILE="$CONFIG_DIR/mdsaddr"
WEBHOOK_URL_FILE="$CONFIG_DIR/webhook_url"
EMAIL_FILE="$CONFIG_DIR/email"
RUNTIME_FILE="$CONFIG_DIR/runtime"
INTENV_FILE="$CONFIG_DIR/int_env"

# Default image
