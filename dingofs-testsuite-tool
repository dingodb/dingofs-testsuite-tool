# Cluster Commands
# ==============================================================================

cmd_cluster() {
    local subcmd="$1"

    case "$subcmd" in
        update)
            shift
            cmd_cluster_update "$@"
            ;;
        status)
            shift
            cmd_cluster_status "$@"
            ;;
        --help|-h)
            echo "Usage: dtt cluster <update|status> [options]"
            echo ""
            echo "Cluster management commands:"
            echo "  update    Update cluster to latest DingoFS image"
            echo "  status    Show cluster status"
            echo ""
            echo "Examples:"
            echo "  dtt cluster update 29 root"
            echo "  dtt cluster status 29 root"
            return 0
            ;;
        *)
            echo "Error: Unknown cluster subcommand '${subcmd:-<empty>}'"
            echo "Usage: dtt cluster <update|status> [options]"
            return 1
            ;;
    esac
}

cmd_cluster_status() {
    local cluster_id="$1"
    local deploy_user="$2"

    if [[ -z "$cluster_id" ]]; then
        echo "Error: Cluster ID required"
        echo "Usage: dtt cluster status <cluster_id> <user>"
        return 1
    fi

    if [[ -z "$deploy_user" ]]; then
        echo "Error: Deploy user required"
        echo "Usage: dtt cluster status <cluster_id> <user>"
        return 1
    fi

    # Resolve dingo path
    local dingo_path=""
    case "$cluster_id" in
        29)
            if [[ "$deploy_user" == "root" ]]; then
                dingo_path="/usr/local/bin/dingo"
            fi
            ;;
        *)
            echo "Error: Unknown cluster '$cluster_id'"
            return 1
            ;;
    esac

    if [[ -z "$dingo_path" ]]; then
        dingo_path=$(command -v dingo) || {
            echo "Error: dingo command not found in PATH"
            return 1
        }
    fi
    local DINGO_BIN="$dingo_path"

    local SUDO=""
    if [[ "$EUID" -ne 0 ]]; then
        SUDO="sudo -E"
    fi

    echo "=============================================="
    echo "Cluster $cluster_id Status"
    echo "=============================================="
    echo ""

    $SUDO $DINGO_BIN cluster status -sv
}

cmd_cluster_update() {
    # Parse -f/--file flag
    local topology_file=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--file)
                topology_file="$2"
                shift 2
                ;;
            --help|-h)
                echo "Usage: dtt cluster update <cluster_id> <user> [<image_tag>] [-f <topology_file>]"
                echo ""
                echo "Update a DingoFS cluster to the latest image."
                echo ""
                echo "Arguments:"
                echo "  cluster_id   Cluster ID (e.g. 29)"
                echo "  user         Deploy user, used to locate topology file"
                echo "               (e.g. root → /root/dingofs/deploy/...)"
                echo "  image_tag    (Optional) Specific image tag to deploy"
                echo "               If omitted, fetches the latest tag from Docker Hub"
                echo ""
                echo "Options:"
                echo "  -f, --file   Override topology YAML file path"
                echo ""
                echo "Examples:"
                echo "  dtt cluster update 29 root"
                echo "  dtt cluster update 29 root 8120cfb"
                echo "  dtt cluster update 29 dingofs"
                echo "  dtt cluster update 29 root -f /custom/topology.yaml"
                return 0
                ;;
            -*)
                echo "Error: Unknown option '$1'"
                return 1
                ;;
            *)
                break
                ;;
        esac
    done

    local cluster_id="$1"
    local deploy_user="$2"
    local image_tag="$3"

    if [[ -z "$cluster_id" ]]; then
        echo "Error: Cluster ID required"
        echo "Usage: dtt cluster update <cluster_id> <user> [<image_tag>] [-f <topology_file>]"
        echo "Example: dtt cluster update 29 root"
        echo "         dtt cluster update 29 root 8120cfb"
        return 1
    fi

    if [[ -z "$deploy_user" ]]; then
        echo "Error: Deploy user required"
        echo "Usage: dtt cluster update <cluster_id> <user> [<image_tag>] [-f <topology_file>]"
        echo "Example: dtt cluster update 29 root"
        echo "         dtt cluster update 29 root 8120cfb"
        return 1
    fi

    # Determine topology file path:
    # 1) -f flag (already set above)
    # 2) built-in mapping: <user_home>/dingofs/deploy/<topology_filename>
    local dingo_path=""
    if [[ -z "$topology_file" ]]; then
        # Resolve user home directory
        local user_home
        if [[ "$deploy_user" == "root" ]]; then
            user_home="/root"
        else
            user_home="/home/$deploy_user"
        fi

        # Built-in cluster mapping
        local topo_filename=""
        case "$cluster_id" in
            29)
                topo_filename="topology-v5.2-main.yaml"
                if [[ "$deploy_user" == "root" ]]; then
                    dingo_path="/usr/local/bin/dingo"
                fi
                ;;
            *)
                echo "Error: Unknown cluster '$cluster_id'"
                echo "Supported clusters: 29"
                return 1
                ;;
        esac

        topology_file="${user_home}/dingofs/deploy/${topo_filename}"
    fi

    # Resolve dingo path if not already set by cluster mapping
    if [[ -z "$dingo_path" ]]; then
        dingo_path=$(command -v dingo) || {
            echo "Error: dingo command not found in PATH"
            return 1
        }
    fi
    local DINGO_BIN="$dingo_path"

    # Determine if we need sudo (before file check, since /root/ needs sudo to access)
    local SUDO=""
    if [[ "$EUID" -ne 0 ]]; then
        SUDO="sudo -E"
    fi

    if ! $SUDO test -f "$topology_file"; then
        echo "Error: Topology file not found: $topology_file"
        return 1
    fi

    if [[ "$EUID" -ne 0 ]]; then
        echo "Not running as root, using sudo for privileged operations"
    fi

    echo "=============================================="
    echo "Updating DingoFS Cluster $cluster_id"
    echo "=============================================="
    echo ""

    # Step 1: Set proxy
    export http_proxy=http://hproxy.it.zetyun.cn:1080
    export https_proxy=http://hproxy.it.zetyun.cn:1080

    local attempt=1
    local max_attempts=2
    local backup_file="${topology_file}.$(date +%Y%m%d_%H%M%S).bak"
    local did_backup=false

    # If user specified an image tag, use it directly (no retry needed)
    if [[ -n "$image_tag" ]]; then
        max_attempts=1
    fi

    while [[ $attempt -le $max_attempts ]]; do
        local tag_label
        if [[ -n "$image_tag" ]]; then
            # User-specified tag, no label needed
            tag_label="specified"
        elif [[ $attempt -eq 1 ]]; then
            tag_label="latest"
        else
            tag_label="previous"
        fi

        if [[ -n "$image_tag" ]]; then
            echo "[1/6] Using specified image tag: $image_tag"
        else
            echo "[1/6] Fetching ${tag_label} image tag (attempt $attempt/$max_attempts)..."
            local result_index
            if [[ $attempt -eq 1 ]]; then
                result_index=0
            else
                result_index=2
            fi
            image_tag=$(curl -fsSL "https://hub.docker.com/v2/repositories/dingodatabase/dingofs/tags/?page_size=3&ordering=last_updated" | jq -r ".results[${result_index}].name")
            if [[ -z "$image_tag" || "$image_tag" == "null" ]]; then
                echo "Error: Failed to get image tag from Docker Hub"
                return 1
            fi
        fi
        echo "      Image tag: $image_tag"

        # Backup and update yaml (only on first attempt)
        if [[ "$did_backup" != "true" ]]; then
            echo "[2/6] Updating topology yaml..."
            $SUDO cp "$topology_file" "$backup_file"
            echo "      Backup saved: $backup_file"
            did_backup=true
        else
            echo "[2/6] Updating topology yaml (retry)..."
        fi
        $SUDO sed -i "0,/^  container_image:.*:/{s/\(container_image: .*:\).*/\1$image_tag/}" "$topology_file"
        echo "      Updated global.container_image in $topology_file"

        # Step 3: Commit config
        echo "[3/6] Committing cluster config..."
        $SUDO $DINGO_BIN config commit -f "$topology_file" || {
            echo "Error: Failed to commit cluster config"
            return 1
        }

        # Step 4: Stop all services
        echo "[4/6] Stopping all services..."
        $SUDO $DINGO_BIN cluster stop -f || {
            echo "Error: Failed to stop services"
            return 1
        }

        # Step 5: Clean old data
        echo "[5/6] Cleaning old data..."
        $SUDO $DINGO_BIN cluster clean -f || {
            echo "Error: Failed to clean old data"
            return 1
        }

        # Step 6: Deploy new services
        echo "[6/6] Deploying new services..."
        local deploy_output
        deploy_output=$($SUDO $DINGO_BIN cluster deploy -k 2>&1) && {
            echo ""
            echo "=============================================="
            echo "Cluster $cluster_id update complete!"
            echo "=============================================="
            echo ""
            echo "New image: harbor.zetyun.cn/dingofs/dingofs:$image_tag"
            return 0
        }

        # Deploy failed — check if it's a pull failure worth retrying
        if echo "$deploy_output" | grep -q "Error-Code: 630001" && \
           echo "$deploy_output" | grep -q "pull image failed" && \
           [[ $attempt -lt $max_attempts ]]; then
            echo "      Image pull failed (630001), retrying with previous image..."
            ((attempt++))
            continue
        fi

        echo "Error: Failed to deploy services"
        echo "$deploy_output"
        return 1
    done

    # Clear proxy
    unset http_proxy https_proxy
}

