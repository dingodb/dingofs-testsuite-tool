    dtt -t xfstest -s auto                # 运行全部
    dtt -t xfstest -s quick               # 快速冒烟
    dtt -t xfstest -s generic/001         # 单个测试
    dtt -t xfstest -s generic/001 --dingo-client ./build/bin/dingo-client

