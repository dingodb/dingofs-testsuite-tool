        docker_cmd+=("-e" "EMAIL_TO=$email_addr")
    fi

    # Integration test environment (--env is required for int tool)
    if [[ "$tool" == "int" ]]; then
        if [[ -z "$int_env_override" ]]; then
            echo "Error: --env <环境名> is required for dtt -t int"
            echo "Example: dtt -t int -s quota --env env_126_quota"
            return 1
        fi
        docker_cmd+=("-e" "INT_ENV=$int_env_override")
    else
        local int_env="${int_env_override:-$(load_config int_env)}"
        int_env="${int_env:-env_126_smoke}"
        docker_cmd+=("-e" "INT_ENV=$int_env")
    fi
    echo "  Env:         $int_env"

    # Smoke exclude list
    if [[ -n "$exclude" ]]; then
        docker_cmd+=("-e" "SMOKE_EXCLUDE=$exclude")
    fi

    # Print execution info
    echo "Starting smoke test suite..."
    echo "  Image:       $image"
    echo "  Test dir:    $mount -> $container_mount"
    echo "  Output dir:  $output -> /output"
    if [[ -n "$wechat" ]]; then
        echo "  WeChat:      enabled"
    fi
    if [[ -n "$email_to" ]]; then
        echo "  Email:       enabled"
    fi
    if [[ -n "$debug" ]]; then
        echo "  Debug:       container will be preserved"
    fi
    echo ""

    # Execute: run container with -t smoke, mounting test/output dirs
    "${docker_cmd[@]}" "$image" /entrypoint.sh -t smoke -m "$container_mount" -o /output
}

cmd_config() {
    local subcommand="$1"
    shift

    case "$subcommand" in
        set)
            local key="$1"
            local value="$2"
            if [[ -z "$key" ]] || [[ -z "$value" ]]; then
                echo "Error: key and value required"
                echo "Usage: dingofs-testsuite-tool config set <key> <value>"
                echo "Keys: testdir(test_dir), output, image, mdsaddr, webhook_url, email, runtime, int_env, custom, repo, xfstest_mds_template"
                return 1
            fi

            case "$key" in
                test_dir)  # alias for testdir
                    key="testdir"
                    ;&
                testdir|output|image|mdsaddr|webhook_url|email|runtime|int_env|custom|repo|xfstest_mds_template)
                    save_config "$key" "$value"
                    echo "$key set to: $value"
                    ;;
                *)
                    echo "Error: Unknown config key '$key'"
                    echo "Valid keys: testdir(test_dir), output, image, mdsaddr, webhook_url, email, runtime, int_env, custom, repo, xfstest_mds_template"
                    return 1
                    ;;
            esac
            ;;
        show)
            echo "Current Configuration:"
            local td=$(load_config testdir)
            local out=$(load_config output)
            local img=$(load_config image)
            local mds=$(load_config mdsaddr)
            local webhook=$(load_config webhook_url)
            local email=$(load_config email)
            local runtime=$(load_config runtime)
            local int_env=$(load_config int_env)
            local custom=$(load_config custom)
            local xfstest_mds=$(load_config xfstest_mds_template)
            echo "  test_dir:              ${td:-not set}"
            echo "  xfstest_mds_template:  ${xfstest_mds:-not set}"
            echo "  output:      ${out:-not set}"
            echo "  image:       ${img:-not set}"
            echo "  mdsaddr:     ${mds:-not set}"
            echo "  webhook_url: ${webhook:-not set}"
            echo "  email:       ${email:-not set}"
            echo "  runtime:     ${runtime:-docker}"
            echo "  int_env:     ${int_env:-env_126_smoke}"
            echo "  custom:      ${custom:-not set}"
            local repo=$(load_config repo)
            echo "  repo:        ${repo:-not set}"
            ;;
        *)
            if [[ -z "$subcommand" ]]; then
                echo "Error: subcommand required"
                echo "Usage: dingofs-testsuite-tool config <set|show>"
                return 1
            fi
            echo "Error: Unknown config subcommand '$subcommand'"
            echo "Usage: dingofs-testsuite-tool config <set|show>"
            return 1
            ;;
    esac
}

cmd_debug() {
    local image=$(load_config image)
    local testdir=$(load_config testdir)
    local output=$(load_config output)
    local mdsaddr=$(load_config mdsaddr)
    local custom=$(load_config custom)
    local runtime=$(load_config runtime)

    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dingofs-testsuite-tool config set image <image>' first."
        return 1
    fi

    echo "Starting debug shell with image: $image"
    echo "Testdir: ${testdir:-<not set>}"
    echo "Output: ${output:-<not set>}"
    echo "MDSAddr: ${mdsaddr:-<not set>}"
    echo "Custom: ${custom:-<not set>}"
    echo ""
    echo "Type 'exit' to leave the container"
    echo ""

    if [[ -n "$testdir" ]]; then
        local host_mount container_target container_mount
        read -r host_mount container_target container_mount <<< "$(resolve_mount_target "$testdir")"
        local user_flag=""
        if ! _is_rootless; then
            user_flag="--user $(stat -c '%u:%g' "$testdir")"
        fi
        local docker_cmd=("$runtime" "run" "-it" "--rm" "--privileged" "--net=host" "--entrypoint" "/bin/bash" $user_flag "-v" "${host_mount}:${container_target}")
    else
        local docker_cmd=("$runtime" "run" "-it" "--rm" "--privileged" "--net=host" "--entrypoint" "/bin/bash")
    fi

    if [[ -n "$output" ]]; then
        mkdir -p "$output"
        docker_cmd+=("-v" "${output}:/output")
    fi

    if [[ -n "$custom" ]]; then
        mkdir -p "$custom"
        docker_cmd+=("-v" "${custom}:/custom")
    fi

    if [[ -n "$mdsaddr" ]]; then
        local -a added_ips=()
        # Extract unique IPs for --add-host (split by comma, extract IP from each, deduplicate)
        while IFS=',' read -ra ADDRS; do
            for addr in "${ADDRS[@]}"; do
                # Trim whitespace
                addr=$(echo "$addr" | xargs)
                [[ -n "$addr" ]] || continue
                local ip="${addr%:*}"
                # Add --add-host for this IP (avoid duplicates)
                local already_added=false
                for existing in "${added_ips[@]}"; do
                    [[ "$existing" == "$ip" ]] && already_added=true && break
                done
                if [[ "$already_added" == "false" ]]; then
                    docker_cmd+=("--add-host" "mds:${ip}")
                    added_ips+=("$ip")
                fi
            done
        done <<< "$mdsaddr"
        # Pass MDSADDR to container as environment variable for dingo CLI
        docker_cmd+=("-e" "MDSADDR=$mdsaddr")
    fi

    docker_cmd+=("$image")

    "${docker_cmd[@]}"
}

run_docker_help() {
    local tool="$1"
    local image=$(load_config image)
    local runtime=$(load_config runtime)

    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dingofs-testsuite-tool config set image <image>' first."
        return 1
    fi

    $runtime run --rm --privileged --net=host "$image" -t "$tool" --help
}

run_testsuite() {
    local image=$(load_config image)
    local config_testdir=$(load_config testdir)
    local config_output=$(load_config output)
    local config_mdsaddr=$(load_config mdsaddr)
    local config_custom=$(load_config custom)
    local runtime=$(load_config runtime)

    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dingofs-testsuite-tool config set image <image>' first."
        echo ""
        echo "Usage:"
        echo "  dingofs-testsuite-tool config set image localhost/dingofs-testsuite-tools:latest"
        return 1
    fi

    # Parse arguments
    local mount="" output="" tool="" scenario="" np="${NP:-16}" bs_size="normal"
    local wechat="" email_to=""
    local scale="${SCALE:-small}" file_count="" gpu_count="${GPU_COUNT:-1}" debug=""
    local setup_env=""
    local do_cleanup=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--mount)
                mount="$2"
                shift 2
                ;;
            -o|--output)
                output="$2"
                shift 2
                ;;
            -t|--tool)
                tool="$2"
                shift 2
                ;;
            -s|--scenario)
                scenario="$2"
                shift 2
                ;;
            -n|--np)
                np="$2"
                shift 2
                ;;
            --wechat)
                wechat="yes"
                shift
                ;;
            --email)
                if [[ -n "$2" ]] && [[ "$2" != -* ]]; then
                    email_to="$2"
                    shift 2
                else
                    email_to="yes"
                    shift
                fi
                ;;
            --bs_size)
                bs_size="$2"
                shift 2
                ;;
            --test-times)
                test_times="$2"
                shift 2
                ;;
            --scale)
                scale="$2"
                shift 2
                ;;
            --file_count)
                file_count="$2"
                shift 2
                ;;
            --gpu_count)
                gpu_count="$2"
                shift 2
                ;;
            --dingo-client)
                dingo_client="$2"
                shift 2
                ;;
            --int-report-port)
                int_report_port="$2"
                shift 2
                ;;
            --duration)
                vd_duration="$2"
                shift 2
                ;;
            --env)
                int_env_override="$2"
                shift 2
                ;;
            --debug)
                debug="yes"
                shift
                ;;
            --setup-env)
                setup_env="$2"
                shift 2
                ;;
            --cleanup)
                do_cleanup="yes"
                shift
                ;;
            --cleanup-env)
                cmd_cleanup_env "$2"
                return $?
                ;;
            --help|-h)
                if [[ -n "$tool" ]]; then
                    if [[ "$tool" == "mlperf" ]]; then
                        show_mlperf_help
                        exit 0
                    elif [[ "$tool" == "xfstest" ]]; then
                        show_xfstest_help
                        exit 0
                    elif [[ "$tool" == "int" ]]; then
                        show_int_help
                        exit 0
                    elif [[ "$tool" == "task" ]]; then
                        show_task_help
                        exit 0
                    elif [[ "$tool" == "elbencho" ]]; then
                        show_elbencho_help
                        exit 0
                    else
                        run_docker_help "$tool"
                        exit $?
                    fi
                else
                    show_help
                    exit 0
                fi
                ;;
            *)
                echo "Error: Unknown option '$1'"
                return 1
                ;;
        esac
    done

    if [[ -n "$do_cleanup" ]] && [[ -z "$setup_env" ]]; then
        echo "Error: --cleanup requires --setup-env, or use --cleanup-env <name> directly"
        return 1
    fi

    # Use config values if not provided via command line
    mount="${mount:-$config_testdir}"
    output="${output:-$config_output}"

    # --- setup-env: create filesystem and mount ---
    if [[ -n "$setup_env" ]]; then
        _run_setup_env "$setup_env" || return $?
        # test_env_setup.py internally ran: dtt config set testdir <mount_path>
        mount=$(load_config testdir)
        echo "Test dir updated to: $mount"
    fi

    # mlperf-specific parameter handling
    if [[ "$tool" == "mlperf" ]]; then
        # Default scenario to "all" if not specified
        scenario="${scenario:-all}"

        # Validate scenario
        case "$scenario" in
            resnet50|unet3d|cosmoflow|checkpointing|all)
                ;;
            *)
                echo "Error: Invalid mlperf scenario '$scenario'"
                echo "Valid scenarios: resnet50, unet3d, cosmoflow, checkpointing, all"
                return 1
                ;;
        esac

        # Validate scale
        case "$scale" in
            small|medium|large)
                ;;
            *)
                echo "Error: Invalid --scale value '$scale'"
                echo "Valid values: small, medium, large"
                return 1
                ;;
        esac

        # Validate file_count if provided
        if [[ -n "$file_count" ]]; then
            if [[ ! "$file_count" =~ ^[1-9][0-9]*$ ]]; then
                echo "Error: --file_count must be a positive integer, got '$file_count'"
                return 1
            fi
        fi

        # Validate gpu_count (positive integer)
        if [[ ! "$gpu_count" =~ ^[1-9][0-9]*$ ]]; then
            echo "Error: --gpu_count must be a positive integer, got '$gpu_count'"
            return 1
        fi

        # Build mlperf docker run command (replaces Phase 15 placeholder)
        # Per D-06/D-07/D-08/D-09: map CLI params to mlperf env vars
        # Per D-02/D-03/D-04: -it --rm --privileged --shm-size=8g
        # Per D-10/D-11: mount testdir→/data, output→/output

        # Verify required config is set
        if [[ -z "$mount" ]]; then
            echo "Error: Test directory not set."
            echo "Please run 'dingofs-testsuite-tool config set testdir <directory>' first."
            return 1
        fi
        if [[ -z "$output" ]]; then
            echo "Error: Output directory not set."
            echo "Please run 'dingofs-testsuite-tool config set output <directory>' first."
            return 1
        fi

        # Validate mount directory exists
        if [[ -f "$mount" ]]; then
            echo "Error: Mount path '$mount' is a file, not a directory"
            return 1
        fi
        mkdir -p "$mount"

        # Resolve mount target (handle FUSE mounts root can't access)
        local host_mount container_target container_mount
        read -r host_mount container_target container_mount <<< "$(resolve_mount_target "$mount")"

        # Create output directory if it doesn't exist
        mkdir -p "$output"

        # Build docker command with mlperf-specific flags (omit --rm in debug mode)
        local mlperf_rm_flag="--rm"
        if [[ -n "$debug" ]]; then
            mlperf_rm_flag=""
        fi
        local docker_cmd=(
            $runtime run -it $mlperf_rm_flag --privileged --net=host
        )
        if ! _is_rootless; then
            docker_cmd+=("--user" "$(stat -c '%u:%g' "$mount")")
        fi
        docker_cmd+=(
            --shm-size=8g
            -v "${host_mount}:${container_target}"
            -v "${output}:/output"
            -e "MODELS=${scenario}"
            -e "NUM_ACCELERATORS=${gpu_count}"
            -e "ACCELERATOR_TYPE=h100"
            -e "LOOPS=1"
            -e "SUBMISSION_MODE=closed"
        )

        # Set SCALE: --file_count takes precedence over --scale (CLI-06)
        if [[ -n "$file_count" ]]; then
            docker_cmd+=("-e" "SCALE=${file_count}")
        else
            docker_cmd+=("-e" "SCALE=${scale}")
        fi

        # Mount custom scenarios directory if configured
        if [[ -n "$config_custom" ]]; then
            mkdir -p "$config_custom"
            docker_cmd+=("-v" "${config_custom}:/custom")
        fi

        # Add container entrypoint args
        docker_cmd+=("$image" "-t" "mlperf" "-s" "${scenario}" "-m" "$container_mount" "-o" "/output")

        # Print what we're about to do
        echo "Starting MLPerf Storage benchmark..."
        echo "  Image:       $image"
        echo "  Models:      $scenario"
        if [[ -n "$file_count" ]]; then
            echo "  Scale:       $file_count files (custom, overrides --scale)"
        else
            echo "  Scale:       $scale"
        fi
        echo "  GPU Count:   $gpu_count"
        echo "  Test dir:    $mount -> $container_mount"
        echo "  Output dir:  $output -> /output"
        echo ""

        # Execute
        exec "${docker_cmd[@]}"
        # exec replaces the shell process, so we never reach here
    fi

    # xfstest: xfstests manages its own mounts via dingo-client + mount helper.
    # No pre-mounted testdir needed; only output is required.
    if [[ "$tool" == "xfstest" ]]; then
        if [[ -z "$scenario" ]]; then
            show_xfstest_help
            return 0
        fi
        if [[ -z "$output" ]]; then
            echo "Error: Output directory not set."
            echo "Please run 'dingofs-testsuite-tool config set output <directory>' first."
            return 1
        fi
        mkdir -p "$output"

        local rm_flag="--rm"
        if [[ -n "$debug" ]]; then
            rm_flag=""
        fi

        local docker_cmd=(
            $runtime run -it $rm_flag --privileged --net=host
            --cap-add=SYS_ADMIN
            -v "${output}:/output"
        )

        # Mount custom scenarios directory if configured
        if [[ -n "$config_custom" ]]; then
            mkdir -p "$config_custom"
            docker_cmd+=("-v" "${config_custom}:/custom")
        fi

        # Mount external dingo-client if specified
        if [[ -n "$dingo_client" ]]; then
            if [[ ! -f "$dingo_client" ]]; then
                echo "Error: dingo-client not found at '$dingo_client'"
                return 1
            fi
            docker_cmd+=(
                -v "${dingo_client}:/usr/local/bin/dingo-client:ro"
                -e "DINGOFS_CLIENT_BIN=/usr/local/bin/dingo-client"
            )
            echo "  Using external dingo-client: $dingo_client"
        fi

        # Pass MDS template for MDS mode
        local config_mds_template=$(load_config xfstest_mds_template 2>/dev/null || echo "")
        if [[ -n "$config_mds_template" ]]; then
            docker_cmd+=("-e" "DINGOFS_META_URL_TEMPLATE=$config_mds_template")
        fi

        local entrypoint_cmd=(
            /entrypoint.sh -t xfstest -o /output
        )
        entrypoint_cmd+=(-s "${scenario:-auto}")

        echo "Running testsuite with image: $image"
        echo "  Output: $output -> /output"
        echo "  Tool: xfstest"
        echo "  Scenario: ${scenario:-auto}"
        if [[ -n "$config_mds_template" ]]; then
            echo "  MDS template: $config_mds_template"
        fi
        echo ""

        exec "${docker_cmd[@]}" "$image" "${entrypoint_cmd[@]}"
    fi

    # Validate required parameters
    if [[ -z "$mount" ]]; then
        echo "Error: Test directory not set."
        echo "Please run 'dingofs-testsuite-tool config set testdir <directory>' first."
        return 1
    fi

    if [[ -z "$output" ]]; then
        echo "Error: Output directory not set."
        echo "Please run 'dingofs-testsuite-tool config set output <directory>' first."
        return 1
    fi

    if [[ -z "$tool" ]]; then
        echo "Error: -t <tool> is required (fio, vdbench, mdtest, pjdtest, ltp, int, mlperf, xfstest, task, elbencho)"
        return 1
    fi

    # Validate mount directory exists
    if [[ -f "$mount" ]]; then
        echo "Error: Mount path '$mount' is a file, not a directory"
        return 1
    fi
    mkdir -p "$mount"

    # Resolve mount target (handle FUSE mounts root can't access)
    local host_mount container_target container_mount
    read -r host_mount container_target container_mount <<< "$(resolve_mount_target "$mount")"

    # Create output directory if it doesn't exist
    mkdir -p "$output"

    # Build docker command (omit --rm in debug mode to preserve container)
    local rm_flag="--rm"
    if [[ -n "$debug" ]]; then
        rm_flag=""
    fi

    # LTP requires rootful podman with runc and /dev/kmsg for kernel test access
    local ltp_extra_flags=()
    if [[ "$tool" == "ltp" ]]; then
        ltp_extra_flags+=("--device" "/dev/kmsg")
        if [[ "$runtime" == "podman" ]]; then
            ltp_extra_flags+=("--runtime=runc")
            runtime="sudo podman"
        fi
    fi

    local docker_cmd=(
        $runtime run $rm_flag --privileged --net=host
    )
    # fio perf/debug needs root for cache clearing; skip --user
    local skip_user=false
    if [[ "$tool" == "fio" ]] && [[ "$scenario" == "perf" || "$scenario" == "debug" ]]; then
        skip_user=true
    fi
    if ! _is_rootless && [[ "$skip_user" != "true" ]]; then
        docker_cmd+=("--user" "$(stat -c '%u:%g' "$mount")")
    fi
    docker_cmd+=(
        "${ltp_extra_flags[@]}"
        -v "${host_mount}:${container_target}"
        -v "${output}:/output"
    )

    # Mount custom scenarios directory if configured
    if [[ -n "$config_custom" ]]; then
        mkdir -p "$config_custom"
        docker_cmd+=("-v" "${config_custom}:/custom")
    fi

    # Pass INT_ENV for integration test environment (--env overrides config)
    local int_env="${int_env_override:-$(load_config int_env)}"
    int_env="${int_env:-env_126_smoke}"
    docker_cmd+=("-e" "INT_ENV=$int_env")

    # Pass MDSADDR to container as environment variable for dingo CLI
    if [[ -n "$config_mdsaddr" ]]; then
        docker_cmd+=("-e" "MDSADDR=$config_mdsaddr")
    fi

    # Add host mapping for MDS if configured
    if [[ -n "$config_mdsaddr" ]]; then
        local -a added_ips=()
        # Extract unique IPs for --add-host (split by comma, extract IP from each, deduplicate)
        while IFS=',' read -ra ADDRS; do
            for addr in "${ADDRS[@]}"; do
                # Trim whitespace
                addr=$(echo "$addr" | xargs)
                [[ -n "$addr" ]] || continue
                local ip="${addr%:*}"
                # Add --add-host for this IP (avoid duplicates)
                local already_added=false
                for existing in "${added_ips[@]}"; do
                    [[ "$existing" == "$ip" ]] && already_added=true && break
                done
                if [[ "$already_added" == "false" ]]; then
                    docker_cmd+=("--add-host" "mds:${ip}")
                    added_ips+=("$ip")
                fi
            done
        done <<< "$config_mdsaddr"
    fi

    # Pass webhook_url if wechat notification enabled
    if [[ -n "$wechat" ]]; then
        local webhook_url=$(load_config webhook_url)
        docker_cmd+=("-e" "WECHAT=yes")
        docker_cmd+=("-e" "WEBHOOK_URL=$webhook_url")
    fi

    # Pass email if email notification enabled
    if [[ -n "$email_to" ]]; then
        local email_addr
        if [[ "$email_to" == "yes" ]]; then
            email_addr=$(load_config email)
        else
            email_addr="$email_to"
        fi
        docker_cmd+=("-e" "EMAIL=yes")
        docker_cmd+=("-e" "EMAIL_TO=$email_addr")
    fi

    # Pass bs_size if specified (for fio)
    if [[ -n "$bs_size" ]]; then
        docker_cmd+=("-e" "BS_SIZE=$bs_size")
    fi

    # Pass test_times if specified (for fio perf)
    if [[ -n "$test_times" ]]; then
        docker_cmd+=("-e" "TEST_TIMES=$test_times")
    fi

    # Build entrypoint command
    local entrypoint_cmd=(
        /entrypoint.sh
        -t "$tool"
        -m "$container_mount"
        -o /output
    )
    # Add scenario (mdtest and elbencho default to "all")
    if [[ "$tool" == "mdtest" ]]; then
        local mdtest_scenario="${scenario:-all}"
        entrypoint_cmd+=(-s "$mdtest_scenario")
    elif [[ "$tool" == "elbencho" ]]; then
        entrypoint_cmd+=(-s "${scenario:-all}")
    else
        # fio, vdbench, pjdtest, ltp, int, task all require scenario; elbencho defaults to all
        if [[ -z "$scenario" ]]; then
            if [[ "$tool" == "elbencho" ]]; then
                scenario="all"
            else
                echo "Error: -s <scenario> is required for fio, vdbench, mdtest, pjdtest, ltp, int, and task"
                return 1
            fi
            return 1
        fi
        entrypoint_cmd+=(-s "$scenario")
    fi

    # Add duration for vdbench stability
    if [[ -n "$vd_duration" ]]; then
        entrypoint_cmd+=("--duration" "$vd_duration")
    fi

    # Add np for mdtest
    if [[ "$tool" == "mdtest" ]]; then
        entrypoint_cmd+=(-n "$np")
    fi

    echo "Running testsuite with image: $image"
    echo "Mount: $mount -> $container_mount  (vol: ${host_mount}:${container_target})"
    echo "Output: $output -> /output"
    echo "Tool: $tool"
    if [[ -n "$scenario" ]]; then
        echo "Scenario: $scenario"
    fi
    if [[ "$tool" == "mdtest" ]]; then
        echo "NP: $np"
    fi
    echo ""

    # Execute docker command with entrypoint
    "${docker_cmd[@]}" "$image" "${entrypoint_cmd[@]}"
    local test_exit=$?

    # Start/restart HTTP server for int allure reports (default port 8800)
    if [[ "$tool" == "int" ]] && [[ -d "$output/int_allure_report" ]]; then
        local int_port="${int_report_port:-8800}"
        if pgrep -f "python.*http.server.*${int_port}" >/dev/null 2>&1; then
            pkill -f "python.*http.server.*${int_port}" 2>/dev/null || true
            sleep 0.5
        fi
        nohup python3 -m http.server ${int_port} --directory "$output/int_allure_report" >/dev/null 2>&1 &
        echo "  Int report:  http://$(hostname -I | awk '{print $1}'):${int_port}/"
    fi

    # --- cleanup: unmount and delete filesystem ---
    if [[ -n "$do_cleanup" ]] && [[ -n "$setup_env" ]]; then
        echo ""
        echo "Cleaning up environment: $setup_env"

        local cleanup_exit=0
        (
            cd "$integration_test_dir"
            python3 -c "
import sys
sys.path.insert(0, '.')
from src.config import env_cleanup
env_cleanup('$setup_env')
"
        ) || cleanup_exit=$?

        if [[ $cleanup_exit -ne 0 ]]; then
            echo "Warning: env_cleanup failed (exit: $cleanup_exit)"
        else
            echo "Environment cleanup complete."
        fi
    fi

    return $test_exit
}

