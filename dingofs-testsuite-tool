cmd_config() {
    local subcommand="$1"
    shift

    case "$subcommand" in
        set)
            local key="$1"
            local value="$2"
            if [[ -z "$key" ]] || [[ -z "$value" ]]; then
                echo "Error: key and value required"
                echo "Usage: dingofs-testsuite-tool config set <key> <value>"
                echo "Keys: testdir, output, image, mdsaddr, webhook_url, email, runtime, int_env, custom, repo"
                return 1
            fi

            case "$key" in
                testdir|output|image|mdsaddr|webhook_url|email|runtime|int_env|custom|repo)
                    save_config "$key" "$value"
                    echo "$key set to: $value"
                    ;;
                *)
                    echo "Error: Unknown config key '$key'"
                    echo "Valid keys: testdir, output, image, mdsaddr, webhook_url, email, runtime, int_env, custom"
                    return 1
                    ;;
            esac
            ;;
        show)
            echo "Current Configuration:"
            local td=$(load_config testdir)
            local out=$(load_config output)
            local img=$(load_config image)
            local mds=$(load_config mdsaddr)
            local webhook=$(load_config webhook_url)
            local email=$(load_config email)
            local runtime=$(load_config runtime)
            local int_env=$(load_config int_env)
            local custom=$(load_config custom)
            echo "  testdir: ${td:-not set}"
            echo "  output:  ${out:-not set}"
            echo "  image:   ${img:-not set}"
            echo "  mdsaddr: ${mds:-not set}"
            echo "  webhook_url: ${webhook:-not set}"
            echo "  email: ${email:-not set}"
            echo "  runtime: ${runtime:-docker}"
            echo "  int_env: ${int_env:-env_126_smoke}"
            echo "  custom:  ${custom:-not set}"
            local repo=$(load_config repo)
            echo "  repo:    ${repo:-not set}"
            ;;
        *)
            if [[ -z "$subcommand" ]]; then
                echo "Error: subcommand required"
                echo "Usage: dingofs-testsuite-tool config <set|show>"
                return 1
            fi
            echo "Error: Unknown config subcommand '$subcommand'"
            echo "Usage: dingofs-testsuite-tool config <set|show>"
            return 1
            ;;
    esac
}

cmd_debug() {
    local image=$(load_config image)
    local testdir=$(load_config testdir)
    local output=$(load_config output)
    local mdsaddr=$(load_config mdsaddr)
    local custom=$(load_config custom)
    local runtime=$(load_config runtime)

    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dingofs-testsuite-tool config set image <image>' first."
        return 1
    fi

    echo "Starting debug shell with image: $image"
    echo "Testdir: ${testdir:-<not set>}"
    echo "Output: ${output:-<not set>}"
    echo "MDSAddr: ${mdsaddr:-<not set>}"
    echo "Custom: ${custom:-<not set>}"
    echo ""
    echo "Type 'exit' to leave the container"
    echo ""

    local debug_extra_args=()
    if [[ -n "$testdir" ]]; then
        local host_mount container_target container_mount
        read -r host_mount container_target container_mount <<< "$(resolve_mount_target "$testdir")"
        local user_flag="--user $(stat -c '%u:%g' "$testdir")"
        if [[ "$container_mount" != "/data" ]]; then
            # FUSE mount: use shell cd to avoid runc mkdir on FUSE path
            debug_extra_args=("-c" "cd $container_mount; exec /bin/bash")
        fi
        local docker_cmd=("$runtime" "run" "-it" "--rm" "--privileged" "--net=host" "--entrypoint" "/bin/bash" $user_flag "-v" "${host_mount}:${container_target}")
    else
        local docker_cmd=("$runtime" "run" "-it" "--rm" "--privileged" "--net=host" "--entrypoint" "/bin/bash")
    fi

    if [[ -n "$output" ]]; then
        mkdir -p "$output"
        docker_cmd+=("-v" "${output}:/output")
    fi

    if [[ -n "$custom" ]]; then
        mkdir -p "$custom"
        docker_cmd+=("-v" "${custom}:/custom")
    fi

    if [[ -n "$mdsaddr" ]]; then
        local -a added_ips=()
        # Extract unique IPs for --add-host (split by comma, extract IP from each, deduplicate)
        while IFS=',' read -ra ADDRS; do
            for addr in "${ADDRS[@]}"; do
                # Trim whitespace
                addr=$(echo "$addr" | xargs)
                [[ -n "$addr" ]] || continue
                local ip="${addr%:*}"
                # Add --add-host for this IP (avoid duplicates)
                local already_added=false
                for existing in "${added_ips[@]}"; do
                    [[ "$existing" == "$ip" ]] && already_added=true && break
                done
                if [[ "$already_added" == "false" ]]; then
                    docker_cmd+=("--add-host" "mds:${ip}")
                    added_ips+=("$ip")
                fi
            done
        done <<< "$mdsaddr"
        # Pass MDSADDR to container as environment variable for dingo CLI
        docker_cmd+=("-e" "MDSADDR=$mdsaddr")
    fi

    docker_cmd+=("$image" "${debug_extra_args[@]}")

    "${docker_cmd[@]}"
}

