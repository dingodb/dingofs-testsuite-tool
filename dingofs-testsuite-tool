        echo "  直接访问失败，尝试 sudo ..."
        sudo docker cp "$src" "$dst"
        return $?
    fi

    echo "$output" >&2
    return 1
}

echo "开始从容器 ${CONTAINER_ID} 复制文件..."

# 复制 dingo-client
if _docker_cp "${CONTAINER_ID}:/dingofs/client/sbin/dingo-client" "${DINGO_CLIENT_DIR}/"; then
    echo "? dingo-client 复制成功"
else
    echo "? dingo-client 复制失败"
    exit 1
fi

# 复制 dingo-mds-client
if _docker_cp "${CONTAINER_ID}:/dingofs/mds-client/sbin/dingo-mds-client" "${DINGO_MDS_CLIENT_DIR}/"; then
    echo "? dingo-mds-client 复制成功"
else
    echo "? dingo-mds-client 复制失败"
    exit 1
fi

# 复制 dingo-cache
if _docker_cp "${CONTAINER_ID}:/dingofs/cache/sbin/dingo-cache" "${DINGO_CACHE_DIR}/"; then
    echo "? dingo-cache 复制成功"
else
    echo "? dingo-cache 复制失败"
    exit 1
fi

# 复制 dingo 工具
if _docker_cp "${CONTAINER_ID}:/dingofs/tools/sbin/dingo" "${DINGO_TOOLS_DIR}/"; then
    echo "? dingo 工具复制成功"
else
    echo "? dingo 工具复制失败"
    exit 1
fi

# 如果用 sudo 复制，修正文件所有者
if [[ "$EUID" -ne 0 ]]; then
    sudo chown -R "$(id -u):$(id -g)" "$DINGO_CLIENT_DIR" "$DINGO_MDS_CLIENT_DIR" "$DINGO_CACHE_DIR" "$DINGO_TOOLS_DIR" 2>/dev/null
fi

echo "所有文件复制完成！"
TOOL_EOF
            ;;
    esac
}

cmd_deploy_bin_tool() {
    local target_user=""
    local mds_addr=""
    local dingo_path=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --user)
                target_user="$2"
                shift 2
                ;;
            --mds)
                mds_addr="$2"
                shift 2
                ;;
            --dingo-path)
                dingo_path="$2"
                shift 2
                ;;
            *)
                echo "错误: 未知选项 '$1'"
                return 1
                ;;
        esac
    done

    if [[ -z "$target_user" ]]; then
        echo "错误: --user 为必填参数"
        return 1
    fi
    if [[ -z "$mds_addr" ]]; then
        echo "错误: --mds 为必填参数"
        return 1
    fi
    if [[ -z "$dingo_path" ]]; then
        echo "错误: --dingo-path 为必填参数"
        return 1
    fi

    local user_home
    if [[ "$target_user" == "root" ]]; then
        user_home="/root"
    else
        user_home="/home/$target_user"
    fi

    local target_bin_dir="${user_home}/bin"

    # 创建目标目录
    if [[ ! -d "$target_bin_dir" ]]; then
        local SUDO=""
        [[ "$EUID" -ne 0 ]] && SUDO="sudo -E"
        $SUDO mkdir -p "$target_bin_dir"
        echo "已创建目录: $target_bin_dir"
    fi

    echo "=============================================="
    echo "部署运维工具"
    echo "=============================================="
    echo "  用户:       $target_user"
    echo "  主目录:     $user_home"
    echo "  MDS:        $mds_addr"
    echo "  dingo:      $dingo_path"
    echo "  目标目录:   $target_bin_dir"
    echo ""

    local mds_primary="${mds_addr%%,*}"  # 取第一个 MDS

    local deployed=0
    local tools=(
        mdscreatefs
        createcache
        deletefs
        deletefsall
        deletecache
        listcache
        listgroup
        dirstat
        edittrashdays
        killclient
        killcache
        listfs
        mountfs
        quotaget
        quotaset
        restoretrash
        umountall
        updatebin
    )

    local SUDO=""
    [[ "$EUID" -ne 0 ]] && SUDO="sudo -E"

    for toolname in "${tools[@]}"; do
        _embedded_tool_content "$toolname" | \
            $SUDO sed \
                -e "s|__MDS_ADDRS__|$mds_addr|g" \
                -e "s|__MDS_ADDR__|$mds_primary|g" \
                -e "s|__DINGO_PATH__|$dingo_path|g" \
                -e "s|__USER_HOME__|$user_home|g" \
                > "/tmp/dtt_bin_tool_$toolname"
        $SUDO mv "/tmp/dtt_bin_tool_$toolname" "$target_bin_dir/$toolname"
        $SUDO chmod +x "$target_bin_dir/$toolname"
        echo "  部署: $toolname"
        deployed=$((deployed + 1))
    done

    echo ""
    echo "=============================================="
    echo "部署完成! (部署 $deployed 个)"
    echo "=============================================="
    echo ""
    echo "请将以下路径添加到 PATH:"
    echo "  export PATH=\"$target_bin_dir:\$PATH\""
}

# ==============================================================================
# cmd_install — 本地安装测试工具到宿主机
# ==============================================================================

cmd_install() {
    local tool="$1"
    shift
    local host=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --host)
                host="$2"
                shift 2
                ;;
            *)
                echo "错误: 未知选项 '$1'"
                return 1
                ;;
        esac
    done

    if [[ -z "$tool" ]]; then
        echo "用法: dtt install <工具> [--host <host名或ip>]"
        echo "目前支持: mdtest"
        return 1
    fi

    case "$tool" in
        mdtest)
            if [[ -n "$host" ]]; then
                _install_mdtest_remote "$host"
            else
                _install_mdtest_local
            fi
            ;;
        *)
            echo "错误: 暂不支持安装 '$tool'，目前仅支持 mdtest"
            return 1
            ;;
    esac
}

_mdtest_build_script() {
    cat << 'BUILD_EOF'
set -e
SUDO=""
[[ "$(id -u)" -ne 0 ]] && SUDO="sudo"

echo "==> 安装编译依赖和 openmpi ..."
if command -v apt-get &> /dev/null; then
    $SUDO apt-get update
    $SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        git build-essential autoconf automake libtool pkg-config openmpi-bin libopenmpi-dev libaio-dev
elif command -v dnf &> /dev/null; then
    $SUDO dnf install -y git gcc gcc-c++ make autoconf automake libtool pkg-config openmpi openmpi-devel libaio-devel
elif command -v yum &> /dev/null; then
    $SUDO yum install -y git gcc gcc-c++ make autoconf automake libtool pkg-config openmpi openmpi-devel libaio-devel
else
    echo "错误: 未检测到 apt-get/dnf/yum，无法安装编译依赖"
    exit 1
fi

# RHEL/CentOS: openmpi 的 mpicc 和 libmpi 在 /usr/lib64/openmpi 下，不在默认路径
if [[ -d /usr/lib64/openmpi/bin ]]; then
    export PATH="/usr/lib64/openmpi/bin:$PATH"
fi
if [[ -d /usr/lib64/openmpi/lib ]] && ls /usr/lib64/openmpi/lib/libmpi.so* &>/dev/null; then
    echo "/usr/lib64/openmpi/lib" | $SUDO tee /etc/ld.so.conf.d/openmpi-x86_64.conf >/dev/null
    $SUDO ldconfig
fi

echo "==> 从源码编译 IOR/mdtest ..."
WORK_DIR=$(mktemp -d /tmp/ior_build.XXXXXX)
trap 'rm -rf "$WORK_DIR"' EXIT
cd "$WORK_DIR"
# 固定到 4.0.0：latest main 要求 autoconf>=2.71，而 RHEL/CentOS 只有 2.69
git clone --depth 1 --branch 4.0.0 https://github.com/hpc/ior.git
cd ior
./bootstrap
./configure --prefix=/usr/local
make -j"$(nproc)"
$SUDO make install

# RHEL/CentOS: mpirun/mpiexec 不在 PATH，软链到 /usr/local/bin
if [[ -d /usr/lib64/openmpi/bin ]]; then
    for b in mpirun mpiexec; do
        $SUDO ln -sf "/usr/lib64/openmpi/bin/$b" "/usr/local/bin/$b"
    done
fi

echo ""
echo "==> 验证 ..."
missing=$(ldd /usr/local/bin/mdtest 2>&1 | grep -i "not found" || true)
if [[ -n "$missing" ]]; then
    echo "警告: 检测到缺失的动态库:"
    echo "$missing"
else
    echo "动态库依赖检查通过"
fi

if command -v mpirun &> /dev/null; then
    echo "mpirun 可用: $(command -v mpirun)"
else
    echo "提示: 未在 PATH 中找到 mpirun"
fi

echo ""
echo "安装完成: /usr/local/bin/mdtest"
echo "运行方式: mpirun -np <进程数> /usr/local/bin/mdtest <选项>"
BUILD_EOF
}

_install_mdtest_local() {
    echo "=============================================="
    echo "本地安装 mdtest（源码编译）"
    echo "=============================================="
    echo "  安装目录: /usr/local/bin"
    echo ""

    _mdtest_build_script | bash
    return $?
}

_install_mdtest_remote() {
    local host="$1"

    if ! command -v ssh &> /dev/null; then
        echo "错误: 未找到 ssh 命令"
        return 1
    fi

    echo "=============================================="
    echo "远程安装 mdtest（源码编译）"
    echo "=============================================="
    echo "  目标主机: $host"
    echo "  安装目录: /usr/local/bin"
    echo ""

    _mdtest_build_script | ssh "$host" bash -s
    return $?
}

# ==============================================================================
# Main Entry Point
# ==============================================================================

dingofs-testsuite-tool() {
    local command="$1"

    case "$command" in
        smoke)
            shift
            cmd_smoke "$@"
            ;;
        daily)
            shift
            cmd_daily "$@"
            ;;
        cluster)
            shift
            cmd_cluster "$@"
            ;;
        deploy)
            shift
            cmd_deploy "$@"
            ;;
        config)
            shift
            cmd_config "$@"
            ;;
        debug)
            cmd_debug
            ;;
        install)
            shift
            cmd_install "$@"
            ;;
        --setup-env)
            shift
            local setup_env_name="$1"
            shift
            cmd_setup_env "$setup_env_name"
            # If -t follows, run the test
            if [[ "$1" == "-t" ]] || [[ "$1" == "--tool" ]]; then
                run_testsuite "$@"
            fi
            ;;
        --cleanup-env)
            shift
            cmd_cleanup_env "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        -t|--tool|-s|--scenario|-n|--np|-m|--mount|-o|--output|--wechat|--email|--bs_size|--scale|--file_count|--gpu_count|--debug)
            # Handle case where command starts with options (no explicit command)
            run_testsuite "$@"
            ;;
        *)
            if [[ -z "$command" ]]; then
                echo "Error: No command specified"
                echo "Run 'dingofs-testsuite-tool help' for usage information"
                return 1
            fi
            echo "Error: Unknown command '$command'"
            echo "Run 'dingofs-testsuite-tool help' for usage information"
            return 1
            ;;
    esac
}

# If script is executed directly (not sourced), run the command
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    dingofs-testsuite-tool "$@"
fi

# Shortcut alias (when sourced)
alias dtt='dingofs-testsuite-tool'