}

show_mlperf_help() {
    cat << 'EOF'
MLPerf Storage 基准测试
======================

MLPerf Storage 是 MLPerf 组织定义的存储性能基准测试套件，用于评估存储系统在机器学习工作负载下的性能表现。

用法:
  dtt -t mlperf [-s <场景>] [--scale <规模>] [--file_count <数量>] [--gpu_count <数量>]

参数:
  -s, --scenario <名称>
      测试场景，可选值:
        resnet50       - ResNet-50 图像分类模型
        unet3d         - 3D U-Net 医学图像分割模型
        cosmoflow      - CosmoFlow 宇宙学模拟模型
        checkpointing  - 检查点读写测试
        all            - 运行所有场景 (默认值)

  --scale <规模>
      测试数据集规模，控制生成的文件数量、文件大小和训练轮数:
        small  - 小型数据集: 32 files, 5 epochs (默认值)
        medium - 中型数据集: 256 files, 10 epochs
        large  - 大型数据集: 1024 files, 20 epochs

  --file_count <数量>
      自定义生成测试文件数量 (正整数)
      注意: 同时指定 --scale 和 --file_count 时，--file_count 优先级更高
      不同 scale 对应的默认 file_count:
        small=32, medium=256, large=1024

  --gpu_count <数量>
      并发 GPU 数量，用于模拟多 GPU 训练场景
      默认值: 1

  --help, -h
      显示此帮助信息

示例:
  # 运行所有场景 (默认 small 规模, 1 GPU)
  dtt -t mlperf -s all

  # 运行单个场景
  dtt -t mlperf -s resnet50

  # 中型规模测试, 4 GPU
  dtt -t mlperf -s unet3d --scale medium --gpu_count 4

  # 自定义 500 个文件 (覆盖 --scale 的默认值)
  dtt -t mlperf -s all --file_count 500

  # 小规模快速验证
  dtt -t mlperf -s checkpointing --scale small

注意:
  - mlperf 使用独立的 mlperf-storage 容器，不依赖 dtt 主镜像
  - 测试数据写入 dtt config testdir 配置的目录
  - 测试结果保存到 dtt config output 配置的目录

更多信息:
  - MLPerf Storage: https://github.com/mlcommons/storage
EOF
}

# ==============================================================================
# Command Handlers
# ==============================================================================

cmd_config() {
    local subcommand="$1"
    shift

    case "$subcommand" in
        set)
            local key="$1"
            local value="$2"
            if [[ -z "$key" ]] || [[ -z "$value" ]]; then
                echo "Error: key and value required"
                echo "Usage: dingofs-testsuite-tool config set <key> <value>"
                echo "Keys: testdir, output, image"
                return 1
            fi

            case "$key" in
                testdir|output|image|mdsaddr|webhook_url|email|runtime)
                    save_config "$key" "$value"
                    echo "$key set to: $value"
                    ;;
                *)
                    echo "Error: Unknown config key '$key'"
                    echo "Valid keys: testdir, output, image, mdsaddr, webhook_url, email, runtime"
                    return 1
                    ;;
            esac
            ;;
        show)
            echo "Current Configuration:"
            local td=$(load_config testdir)
            local out=$(load_config output)
            local img=$(load_config image)
            local mds=$(load_config mdsaddr)
            local webhook=$(load_config webhook_url)
            local email=$(load_config email)
            local runtime=$(load_config runtime)
            echo "  testdir: ${td:-not set}"
            echo "  output:  ${out:-not set}"
            echo "  image:   ${img:-not set}"
            echo "  mdsaddr: ${mds:-not set}"
            echo "  webhook_url: ${webhook:-not set}"
            echo "  email: ${email:-not set}"
            echo "  runtime: ${runtime:-docker}"
            ;;
        *)
            if [[ -z "$subcommand" ]]; then
                echo "Error: subcommand required"
                echo "Usage: dingofs-testsuite-tool config <set|show>"
                return 1
            fi
            echo "Error: Unknown config subcommand '$subcommand'"
            echo "Usage: dingofs-testsuite-tool config <set|show>"
            return 1
            ;;
    esac
}

cmd_debug() {
    local image=$(load_config image)
    local testdir=$(load_config testdir)
    local output=$(load_config output)
    local mdsaddr=$(load_config mdsaddr)
    local runtime=$(load_config runtime)

    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dingofs-testsuite-tool config set image <image>' first."
        return 1
    fi

    echo "Starting debug shell with image: $image"
    echo "Testdir: ${testdir:-<not set>}"
    echo "Output: ${output:-<not set>}"
    echo "MDSAddr: ${mdsaddr:-<not set>}"
    echo ""
    echo "Type 'exit' to leave the container"
    echo ""

    local docker_cmd=("$runtime" "run" "-it" "--rm" "--privileged" "--entrypoint" "/bin/bash")

    if [[ -n "$testdir" ]]; then
        docker_cmd+=("-v" "${testdir}:/data")
    fi

    if [[ -n "$output" ]]; then
        docker_cmd+=("-v" "${output}:/output")
    fi

    if [[ -n "$mdsaddr" ]]; then
        local -a added_ips=()
        # Extract unique IPs for --add-host (split by comma, extract IP from each, deduplicate)
        while IFS=',' read -ra ADDRS; do
            for addr in "${ADDRS[@]}"; do
                # Trim whitespace
                addr=$(echo "$addr" | xargs)
                [[ -n "$addr" ]] || continue
                local ip="${addr%:*}"
                # Add --add-host for this IP (avoid duplicates)
                local already_added=false
                for existing in "${added_ips[@]}"; do
                    [[ "$existing" == "$ip" ]] && already_added=true && break
                done
                if [[ "$already_added" == "false" ]]; then
                    docker_cmd+=("--add-host" "mds:${ip}")
                    added_ips+=("$ip")
                fi
            done
        done <<< "$mdsaddr"
        # Pass MDSADDR to container as environment variable for dingo CLI
        docker_cmd+=("-e" "MDSADDR=$mdsaddr")
    fi

    docker_cmd+=("$image")

    "${docker_cmd[@]}"
}

run_docker_help() {
    local tool="$1"
    local image=$(load_config image)
    local runtime=$(load_config runtime)

    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dingofs-testsuite-tool config set image <image>' first."
        return 1
    fi

    $runtime run --rm "$image" -t "$tool" --help
}

run_testsuite() {
    local image=$(load_config image)
    local config_testdir=$(load_config testdir)
    local config_output=$(load_config output)
    local config_mdsaddr=$(load_config mdsaddr)
    local runtime=$(load_config runtime)

    if [[ -z "$image" ]]; then
        echo "Error: No Docker image configured."
        echo "Please run 'dingofs-testsuite-tool config set image <image>' first."
        echo ""
        echo "Usage:"
        echo "  dingofs-testsuite-tool config set image localhost/dingofs-testsuite-tools:latest"
        return 1
    fi

    # Parse arguments
    local mount="" output="" tool="" scenario="" np="${NP:-16}" bs_size="normal"
    local wechat="" email_to=""
    local scale="${SCALE:-small}" file_count="" gpu_count="${GPU_COUNT:-1}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--mount)
                mount="$2"
                shift 2
                ;;
            -o|--output)
                output="$2"
                shift 2
                ;;
            -t|--tool)
                tool="$2"
                shift 2
                ;;
            -s|--scenario)
                scenario="$2"
                shift 2
                ;;
            -n|--np)
                np="$2"
                shift 2
                ;;
            --wechat)
                wechat="yes"
                shift
                ;;
            --email)
                email_to="yes"
                shift
                ;;
            --bs_size)
                bs_size="$2"
                shift 2
                ;;
            --scale)
                scale="$2"
                shift 2
                ;;
            --file_count)
                file_count="$2"
                shift 2
                ;;
            --gpu_count)
                gpu_count="$2"
                shift 2
                ;;
            --help|-h)
                if [[ -n "$tool" ]]; then
                    if [[ "$tool" == "mlperf" ]]; then
                        show_mlperf_help
                        exit 0
                    else
                        run_docker_help "$tool"
                        exit $?
                    fi
                else
                    show_help
                    exit 0
                fi
                ;;
            *)
                echo "Error: Unknown option '$1'"
                return 1
                ;;
        esac
    done

    # Use config values if not provided via command line
    mount="${mount:-$config_testdir}"
    output="${output:-$config_output}"

    # mlperf-specific parameter handling
    if [[ "$tool" == "mlperf" ]]; then
        # Default scenario to "all" if not specified
        scenario="${scenario:-all}"

        # Validate scenario
        case "$scenario" in
            resnet50|unet3d|cosmoflow|checkpointing|all)
                ;;
            *)
                echo "Error: Invalid mlperf scenario '$scenario'"
                echo "Valid scenarios: resnet50, unet3d, cosmoflow, checkpointing, all"
                return 1
                ;;
        esac

        # Validate scale
        case "$scale" in
            small|medium|large)
                ;;
            *)
                echo "Error: Invalid --scale value '$scale'"
                echo "Valid values: small, medium, large"
                return 1
                ;;
        esac

        # Validate file_count if provided
        if [[ -n "$file_count" ]]; then
            if [[ ! "$file_count" =~ ^[1-9][0-9]*$ ]]; then
                echo "Error: --file_count must be a positive integer, got '$file_count'"
                return 1
            fi
        fi

        # Validate gpu_count (positive integer)
        if [[ ! "$gpu_count" =~ ^[1-9][0-9]*$ ]]; then
            echo "Error: --gpu_count must be a positive integer, got '$gpu_count'"
            return 1
        fi

        # Build mlperf docker run command (replaces Phase 15 placeholder)
        # Per D-06/D-07/D-08/D-09: map CLI params to mlperf env vars
        # Per D-02/D-03/D-04: -it --rm --privileged --shm-size=8g
        # Per D-10/D-11: mount testdir→/data, output→/output

        # Verify required config is set
        if [[ -z "$mount" ]]; then
            echo "Error: Test directory not set."
            echo "Please run 'dingofs-testsuite-tool config set testdir <directory>' first."
            return 1
        fi
        if [[ -z "$output" ]]; then
            echo "Error: Output directory not set."
            echo "Please run 'dingofs-testsuite-tool config set output <directory>' first."
            return 1
        fi

        # Validate mount directory exists
        if [[ ! -d "$mount" ]]; then
            echo "Error: Mount directory '$mount' does not exist"
            return 1
        fi

        # Create output directory if it doesn't exist
        mkdir -p "$output"

        # Build docker command with mlperf-specific flags
        local docker_cmd=(
            $runtime run -it --rm --privileged
            --shm-size=8g
            -v "${mount}:/data"
            -v "${output}:/output"
            -e "MODELS=${scenario}"
            -e "NUM_ACCELERATORS=${gpu_count}"
            -e "ACCELERATOR_TYPE=h100"
            -e "LOOPS=1"
            -e "SUBMISSION_MODE=closed"
        )

        # Set SCALE: --file_count takes precedence over --scale (CLI-06)
        if [[ -n "$file_count" ]]; then
            docker_cmd+=("-e" "SCALE=${file_count}")
        else
            docker_cmd+=("-e" "SCALE=${scale}")
        fi

        # Add container entrypoint args
        docker_cmd+=("$image" "-t" "mlperf" "-s" "${scenario}" "-m" "/data" "-o" "/output")

        # Print what we're about to do
        echo "Starting MLPerf Storage benchmark..."
        echo "  Image:       $image"
        echo "  Models:      $scenario"
        if [[ -n "$file_count" ]]; then
            echo "  Scale:       $file_count files (custom, overrides --scale)"
        else
            echo "  Scale:       $scale"
        fi
        echo "  GPU Count:   $gpu_count"
        echo "  Test dir:    $mount -> /data"
        echo "  Output dir:  $output -> /output"
        echo ""

        # Execute
        exec "${docker_cmd[@]}"
        # exec replaces the shell process, so we never reach here
    fi

    # Validate required parameters
    if [[ -z "$mount" ]]; then
        echo "Error: Test directory not set."
        echo "Please run 'dingofs-testsuite-tool config set testdir <directory>' first."
        return 1
    fi

    if [[ -z "$output" ]]; then
        echo "Error: Output directory not set."
        echo "Please run 'dingofs-testsuite-tool config set output <directory>' first."
        return 1
    fi

    if [[ -z "$tool" ]]; then
        echo "Error: -t <tool> is required (fio, vdbench, mdtest, pjdtest, ltp, int, mlperf)"
        return 1
    fi

    # Validate mount directory exists
    if [[ ! -d "$mount" ]]; then
        echo "Error: Mount directory '$mount' does not exist"
        return 1
    fi

    # Create output directory if it doesn't exist
    mkdir -p "$output"

    # Build docker command
    local docker_cmd=(
        $runtime run --rm --privileged
        -v "${mount}:/data"
        -v "${output}:/output"
    )

    # Pass MDSADDR to container as environment variable for dingo CLI
    if [[ -n "$config_mdsaddr" ]]; then
        docker_cmd+=("-e" "MDSADDR=$config_mdsaddr")
    fi

    # Add host mapping for MDS if configured
    if [[ -n "$config_mdsaddr" ]]; then
        local -a added_ips=()
        # Extract unique IPs for --add-host (split by comma, extract IP from each, deduplicate)
        while IFS=',' read -ra ADDRS; do
            for addr in "${ADDRS[@]}"; do
                # Trim whitespace
                addr=$(echo "$addr" | xargs)
                [[ -n "$addr" ]] || continue
                local ip="${addr%:*}"
                # Add --add-host for this IP (avoid duplicates)
                local already_added=false
                for existing in "${added_ips[@]}"; do
                    [[ "$existing" == "$ip" ]] && already_added=true && break
                done
                if [[ "$already_added" == "false" ]]; then
                    docker_cmd+=("--add-host" "mds:${ip}")
                    added_ips+=("$ip")
                fi
            done
        done <<< "$config_mdsaddr"
    fi

    # Pass webhook_url if wechat notification enabled
    if [[ -n "$wechat" ]]; then
        local webhook_url=$(load_config webhook_url)
        docker_cmd+=("-e" "WECHAT=yes")
        docker_cmd+=("-e" "WEBHOOK_URL=$webhook_url")
    fi

    # Pass email if email notification enabled
    if [[ -n "$email_to" ]]; then
        local email_addr=$(load_config email)
        docker_cmd+=("-e" "EMAIL=yes")
        docker_cmd+=("-e" "EMAIL_TO=$email_addr")
    fi

    # Pass bs_size if specified (for fio)
    if [[ -n "$bs_size" ]]; then
        docker_cmd+=("-e" "BS_SIZE=$bs_size")
    fi

    # Build entrypoint command
    local entrypoint_cmd=(
        /entrypoint.sh
        -t "$tool"
        -m /data
        -o /output
    )

    # Add scenario for all tools (mdtest is optional, others required)
    if [[ "$tool" == "mdtest" ]]; then
        # mdtest scenario is optional, default to "all" if not specified
        local mdtest_scenario="${scenario:-all}"
        entrypoint_cmd+=(-s "$mdtest_scenario")
    else
        # fio, vdbench, pjdtest, ltp, int all require scenario
        if [[ -z "$scenario" ]]; then
            echo "Error: -s <scenario> is required for fio, vdbench, mdtest, pjdtest, ltp, and int"
            return 1
        fi
        entrypoint_cmd+=(-s "$scenario")
    fi

    # Add np for mdtest
    if [[ "$tool" == "mdtest" ]]; then
        entrypoint_cmd+=(-n "$np")
    fi

    echo "Running testsuite with image: $image"
    echo "Mount: $mount -> /data"
    echo "Output: $output -> /output"
    echo "Tool: $tool"
    if [[ -n "$scenario" ]]; then
        echo "Scenario: $scenario"
    fi
    if [[ "$tool" == "mdtest" ]]; then
        echo "NP: $np"
    fi
    echo ""

    # Execute docker command with entrypoint
    "${docker_cmd[@]}" "$image" "${entrypoint_cmd[@]}"
}

# ==============================================================================
# Main Entry Point
# ==============================================================================

dingofs-testsuite-tool() {
    local command="$1"

    case "$command" in
        config)
            shift
            cmd_config "$@"
            ;;
        debug)
            cmd_debug
            ;;
        help|--help|-h)
            show_help
            ;;
        -t|--tool|-s|--scenario|-n|--np|-m|--mount|-o|--output|--wechat|--email|--bs_size|--scale|--file_count|--gpu_count)
            # Handle case where command starts with options (no explicit command)
            run_testsuite "$@"
            ;;
        *)
            if [[ -z "$command" ]]; then
                echo "Error: No command specified"
                echo "Run 'dingofs-testsuite-tool help' for usage information"
                return 1
            fi
            echo "Error: Unknown command '$command'"
            echo "Run 'dingofs-testsuite-tool help' for usage information"
            return 1
            ;;
    esac
}

# If script is executed directly (not sourced), run the command
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    dingofs-testsuite-tool "$@"
fi

# Shortcut alias (when sourced)
alias dtt='dingofs-testsuite-tool'